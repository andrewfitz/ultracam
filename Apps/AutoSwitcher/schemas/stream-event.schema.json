{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ultracam-auto-switcher/stream-event",
  "title": "Auto switcher stream event",
  "type": "object",
  "required": ["type"],
  "properties": {
    "type": { "enum": ["audio", "transcript", "video", "tick", "acknowledge", "reject", "manualOverride", "take", "reset", "directorOutput"] },
    "cue": { "type": "object" },
    "observation": { "type": "object" },
    "time": { "type": "number", "minimum": 0 },
    "decision_id": { "type": "string", "format": "uuid" },
    "applied_at": { "type": ["number", "null"], "minimum": 0 },
    "camera_id": { "type": "string" },
    "generation": { "type": ["integer", "null"], "minimum": 0 }
  },
  "allOf": [
    { "if": { "properties": { "type": { "const": "audio" } } }, "then": { "required": ["cue"], "properties": { "cue": { "$ref": "#/$defs/audio" } } } },
    { "if": { "properties": { "type": { "const": "transcript" } } }, "then": { "required": ["cue"], "properties": { "cue": { "$ref": "#/$defs/transcript" } } } },
    { "if": { "properties": { "type": { "const": "video" } } }, "then": { "required": ["observation"], "properties": { "observation": { "$ref": "#/$defs/video" } } } },
    { "if": { "properties": { "type": { "const": "tick" } } }, "then": { "required": ["time"] } },
    { "if": { "properties": { "type": { "enum": ["acknowledge", "reject"] } } }, "then": { "required": ["decision_id"] } },
    { "if": { "properties": { "type": { "enum": ["manualOverride","take"] } } }, "then": { "required": ["camera_id", "time"] } }
  ],
  "$defs": {
    "audio": {
      "type": "object",
      "required": ["id", "time", "speech_energy"],
      "properties": {
        "id": { "type": "integer", "minimum": 0 },
        "time": { "type": "number", "minimum": 0 },
        "duration": { "type": "number", "minimum": 0 },
        "features": { "type": "object", "additionalProperties": { "type": "number" } },
        "speech_energy": { "type": "number" },
        "pause_duration": { "type": "number" },
        "emphasis": { "type": "number" },
        "laughter": { "type": "number" },
        "speech_start": { "type": "boolean" },
        "speech_stop": { "type": "boolean" },
        "session_generation": { "type": "integer", "minimum": 0 }
      }
    },
    "transcript": {
      "type": "object",
      "required": ["segment_id", "revision", "start", "end", "kind", "confidence", "is_final"],
      "properties": {
        "text": { "type": ["string", "null"] },
        "speaker": { "type": ["string", "null"] },
        "segment_id": { "type": "string" },
        "revision": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "start": { "type": "number", "minimum": 0 },
        "end": { "type": "number", "minimum": 0 },
        "kind": { "enum": ["phraseEnd", "sentenceEnd", "question", "transition"] },
        "confidence": { "type": "number" },
        "is_final": { "type": "boolean" },
        "session_generation": { "type": "integer", "minimum": 0 }
      }
    },
    "video": {
      "type": "object",
      "required": ["time", "camera_id"],
      "properties": {
        "time": { "type": "number", "minimum": 0 },
        "camera_id": { "type": "string" },
        "healthy": { "type": "boolean" },
        "motion": { "type": "number" },
        "scene_change": { "type": "number" },
        "eye_contact": { "type": "number", "minimum": 0, "maximum": 1 },
        "provider_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "session_generation": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
