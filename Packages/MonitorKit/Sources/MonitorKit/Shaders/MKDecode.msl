// MonitorKit frame decoding: every layout read straight from the host's textures.
// Self-contained after MKLUT.msl (or on its own): a host can prepend it and call
// mk_decodeRGB in its own kernel.
// The whole file is one guarded unit: including it twice is harmless.
#ifndef MK_DECODE_MSL
#define MK_DECODE_MSL
#include <metal_stdlib>
using namespace metal;

// Mirrors MonitorKit.FrameParameters.
struct mk_FrameParams {
  uint4 shape;      // x: layout (0 v210, 1 uyvy8, 2 yuyv8, 3 biplanar, 4 rgb), y: width, z: height, w: subsampling (0 4:4:4, 1 4:2:2, 2 4:2:0)
  uint4 options;    // x: chroma centred, y: full range, z: log rescaled into legal, w: integral 10-bit codes
  float4 matrix;    // kr, kg, kb of the Y'CbCr matrix; w: 4:2:0 vertical chroma offset in luma rows (0 centred, -.5 top, .5 bottom)
  float4 levels;    // luma black, luma span, chroma centre, chroma span, in stored codes
  float4 codeScale; // x: luma texel to code, y: chroma texel to code, z: RGB maximum code, w: float RGB
};
static_assert(sizeof(mk_FrameParams) == 80, "mk_FrameParams is MonitorKit.FrameParameters: five 16-byte rows");

constant uint MK_V210 = 0, MK_UYVY8 = 1, MK_YUYV8 = 2, MK_BIPLANAR = 3, MK_RGB = 4;

// The frame's layout. MonitorEngine defines MK_LAYOUT as a function constant in
// its own library, so each of its pipelines compiles one layout's decode (lower
// register pressure); a host that prepends this file reads it at run time.
#ifndef MK_LAYOUT
#define MK_LAYOUT(f) ((f).shape.x)
#endif

// Y' from R'G'B'. Written as g + kr(r - g) + kb(b - g) (kg = 1 - kr - kb) so a
// neutral input returns its value exactly, which keeps classification
// boundaries at integral codes exact.
inline float mk_luma(float3 rgb, float3 k) { return rgb.g + k.x * (rgb.r - rgb.g) + k.z * (rgb.b - rgb.g); }

// v210: one rgba32Uint texel is one 6-pixel group, words Cb0 Y0 Cr0 | Y1 Cb1 Y2 |
// Cr1 Y3 Cb2 | Y4 Cr2 Y5, each component 10 bits from bit 0 (SMPTE RP 2027, Apple
// 'v210'). Lanes are picked arithmetically, not by a switch: neighbouring pixels
// take different lanes, and a switch would diverge.
inline float mk_v210Luma(uint4 g, uint n) { return float((g[(2 * n + 1) / 3] >> ((n % 3 * 20 + 10) % 30)) & 1023); }
// Cb of lane l is word l at bit 10l; Cr is word 0, 2, 3 at bit 20, 0, 10.
inline float2 mk_v210Chroma(uint4 g, uint l) {
  return float2((g[l] >> (10 * l)) & 1023, (g[l + min(l, 1u)] >> ((20 + 10 * l) % 30)) & 1023);
}

// Luma code of pixel xy.
float mk_lumaCode(texture2d<uint, access::read> packed, texture2d<float, access::read> luma,
                  uint2 xy, constant mk_FrameParams& f) {
  if (MK_LAYOUT(f) == MK_V210) return mk_v210Luma(packed.read(uint2(xy.x / 6, xy.y)), xy.x % 6);
  if (MK_LAYOUT(f) == MK_UYVY8) { uint4 t = packed.read(uint2(xy.x / 2, xy.y)); return float((xy.x & 1) ? t.a : t.g); }
  if (MK_LAYOUT(f) == MK_YUYV8) { uint4 t = packed.read(uint2(xy.x / 2, xy.y)); return float((xy.x & 1) ? t.b : t.r); }
  return luma.read(xy).r * f.codeScale.x;
}

// Cb, Cr codes of chroma sample c (in chroma-plane coordinates, already clamped).
float2 mk_chromaSample(texture2d<uint, access::read> packed, texture2d<float, access::read> chroma,
                       uint2 c, constant mk_FrameParams& f) {
  if (MK_LAYOUT(f) == MK_V210) return mk_v210Chroma(packed.read(uint2(c.x / 3, c.y)), c.x % 3);
  if (MK_LAYOUT(f) == MK_UYVY8) { uint4 t = packed.read(c); return float2(t.r, t.b); }
  if (MK_LAYOUT(f) == MK_YUYV8) { uint4 t = packed.read(c); return float2(t.g, t.a); }
  return chroma.read(c).rg * f.codeScale.y;
}

// Cb, Cr codes at luma pixel xy, linearly interpolated to the luma position.
// Horizontal siting: left (co-sited with even luma) or centred. 4:2:0 chroma row j
// sits at luma row 2j + 0.5 + matrix.w: midway (MPEG-2), top or bottom (H.273).
float2 mk_chromaCode(texture2d<uint, access::read> packed, texture2d<float, access::read> chroma,
                     uint2 xy, constant mk_FrameParams& f) {
  if (f.shape.w == 0) return mk_chromaSample(packed, chroma, xy, f);
  int cw = int((f.shape.y + 1) / 2), ch = f.shape.w == 2 ? int((f.shape.z + 1) / 2) : int(f.shape.z);
  float cx = (float(xy.x) - (f.options.x ? 0.5f : 0.0f)) * 0.5f;
  float fx0 = floor(cx), fx = cx - fx0;
  int x0 = clamp(int(fx0), 0, cw - 1), x1 = clamp(int(fx0) + 1, 0, cw - 1);
  // At 1:1 neighbouring pixels alternate between co-sited and interpolated, so
  // this branch diverges there and costs what reading both would; minified, each
  // tap's parity is uniform and the co-sited taps skip a read.
  if (f.shape.w == 1) {
    float2 a = mk_chromaSample(packed, chroma, uint2(x0, xy.y), f);
    return fx == 0 ? a : mix(a, mk_chromaSample(packed, chroma, uint2(x1, xy.y), f), fx);
  }
  float cy = (float(xy.y) - 0.5f - f.matrix.w) * 0.5f;
  float fy0 = floor(cy), fy = cy - fy0;
  int y0 = clamp(int(fy0), 0, ch - 1), y1 = clamp(int(fy0) + 1, 0, ch - 1);
  float2 top = mix(mk_chromaSample(packed, chroma, uint2(x0, y0), f), mk_chromaSample(packed, chroma, uint2(x1, y0), f), fx);
  float2 bottom = mix(mk_chromaSample(packed, chroma, uint2(x0, y1), f), mk_chromaSample(packed, chroma, uint2(x1, y1), f), fx);
  return mix(top, bottom, fy);
}

// a / b correctly rounded (IEEE 754 round to nearest, as the safe-math `/`), given
// r = 1 / b correctly rounded: q = a·r is within 1.5 ulp of a / b; one fused
// Newton step, q + (a - b·q)·r, makes it faithful, and a second one rounds it
// correctly with an exact remainder (Markstein's theorem: P. Markstein, "Computation
// of elementary functions on the IBM RISC System/6000 processor", IBM J. Res. Dev.
// 34(1), 1990; J.-M. Muller et al., Handbook of Floating-Point Arithmetic, 2nd ed.,
// 2018, §4.7). One multiply and four fused multiply-adds against the correctly
// rounded division's long sequence; a shared divisor pays its reciprocal once.
// For finite a and a quotient in the normal range (or zero, whose sign it keeps):
// decoded integral codes and their filtered means, never float-texture values.
inline float mk_quotient(float a, float b, float r) {
  float q = a * r;
  q = fma(fma(-q, b, a), r, q);
  q = fma(fma(-q, b, a), r, q);
  return q == 0 ? a * r : q;
}
inline float2 mk_quotient(float2 a, float b, float r) { return float2(mk_quotient(a.x, b, r), mk_quotient(a.y, b, r)); }
inline float3 mk_quotient(float3 a, float b, float r) {
  return float3(mk_quotient(a.x, b, r), mk_quotient(a.y, b, r), mk_quotient(a.z, b, r));
}

float3 mk_ycbcrToRGB(float y, float2 c, float4 m) {
  // Exact neutral: chroma at its centre reconstructs Y in every channel.
  if (c.x == 0 && c.y == 0) return float3(y);
  float r = y + 2 * (1 - m.x) * c.y, b = y + 2 * (1 - m.z) * c.x;
  return float3(r, (y - m.x * r - m.z * b) / m.y, b);
}

// mk_ycbcrToRGB with the green quotient from `inverseG` = 1 / m.y: the same values.
float3 mk_ycbcrToRGB(float y, float2 c, float4 m, float inverseG) {
  if (c.x == 0 && c.y == 0) return float3(y);
  float r = y + 2 * (1 - m.x) * c.y, b = y + 2 * (1 - m.z) * c.x;
  return float3(r, mk_quotient(y - m.x * r - m.z * b, m.y, inverseG), b);
}

// The chroma sample after lane l of group g: the next lane, or the first lane of
// the next group (one more read, only at a group's last pair). Clamped at the edge.
float2 mk_v210NextChroma(texture2d<uint, access::read> packed, uint4 g, uint l, uint2 xy, constant mk_FrameParams& f) {
  if (xy.x / 2 + 1 >= (f.shape.y + 1) / 2) return mk_v210Chroma(g, l);
  return l < 2 ? mk_v210Chroma(g, l + 1) : mk_v210Chroma(packed.read(uint2(xy.x / 6 + 1, xy.y)), 0);
}

// Left-sited v210, the common case: one group read serves the pixel's luma and its
// co-sited chroma; an odd pixel interpolates midway to the next chroma sample.
float3 mk_v210Codes(texture2d<uint, access::read> packed, uint2 xy, constant mk_FrameParams& f) {
  uint4 g = packed.read(uint2(xy.x / 6, xy.y));
  uint n = xy.x % 6;
  float2 c = mk_v210Chroma(g, n / 2);
  if (n & 1) c = mix(c, mk_v210NextChroma(packed, g, n / 2, xy, f), .5f);
  return float3(mk_v210Luma(g, n), c);
}

// Codes averaged over pixels x and x + 1 of a left-sited v210 row, x even. The pair
// shares one group, so one read (two at a group's last pair) replaces three; the
// chroma average of the co-sited and the midway pixel is mix(c, next, 1/4).
float3 mk_v210PairCodes(texture2d<uint, access::read> packed, uint2 xy, constant mk_FrameParams& f) {
  uint4 g = packed.read(uint2(xy.x / 6, xy.y));
  uint n = xy.x % 6;
  float2 c = mix(mk_v210Chroma(g, n / 2), mk_v210NextChroma(packed, g, n / 2, xy, f), .25f);
  return float3((mk_v210Luma(g, n) + mk_v210Luma(g, n + 1)) * .5f, c);
}

float4 mk_codesToRGB(float3 codes, constant mk_FrameParams& f) {
  float y = (codes.x - f.levels.x) / f.levels.y;
  return float4(mk_ycbcrToRGB(y, (codes.yz - f.levels.z) / f.levels.w, f.matrix), y);
}

// Range-expanded, matrix-decoded R'G'B' at pixel xy in .rgb, and the transport
// luma Y' in .w. Nothing is clipped: footroom and headroom stay below 0 and above 1.
float4 mk_decode(texture2d<uint, access::read> packed, texture2d<float, access::read> luma,
                 texture2d<float, access::read> chroma, uint2 xy, constant mk_FrameParams& f) {
  if (MK_LAYOUT(f) == MK_V210 && !f.options.x) return mk_codesToRGB(mk_v210Codes(packed, xy, f), f);
  if (MK_LAYOUT(f) == MK_RGB) {
    float3 rgb = luma.read(xy).rgb;
    if (f.codeScale.w == 0 && !f.options.y) rgb = (rgb * f.codeScale.z - f.levels.x) / f.levels.y;
    return float4(rgb, mk_luma(rgb, f.matrix.xyz));
  }
  float y = (mk_lumaCode(packed, luma, xy, f) - f.levels.x) / f.levels.y;
  float2 c = (mk_chromaCode(packed, chroma, xy, f) - f.levels.z) / f.levels.w;
  return float4(mk_ycbcrToRGB(y, c, f.matrix), y);
}

float3 mk_decodeRGB(texture2d<uint, access::read> packed, texture2d<float, access::read> luma,
                    texture2d<float, access::read> chroma, uint2 xy, constant mk_FrameParams& f) {
  return mk_decode(packed, luma, chroma, xy, f).rgb;
}

// Transport luma only: the cheapest read, for edge detection.
float mk_decodeLuma(texture2d<uint, access::read> packed, texture2d<float, access::read> luma,
                    texture2d<float, access::read> chroma, uint2 xy, constant mk_FrameParams& f) {
  if (MK_LAYOUT(f) == MK_RGB) return mk_decode(packed, luma, chroma, xy, f).w;
  return (mk_lumaCode(packed, luma, xy, f) - f.levels.x) / f.levels.y;
}

// The camera's full-range signal from codes of a full-range container that a
// recorder squeezed into the container's own legal range, 16s…235s with
// s = 2^(n-8), as an n-bit legal encode places them (BT.709 item 3.4). levels.y
// is the full container's maximum code 2^n - 1 (1023 for float RGB), so at
// 10 bits this is (code - 64) / 876.
float3 mk_unsqueezeLegal(float3 code, constant mk_FrameParams& f) {
  float s = (f.levels.y + 1) * (1.0f / 256);
  return (code - 16 * s) / (219 * s);
}

// Native normalized log codes (code / 1023) from range-expanded values. Depends
// on how the camera's codes were transported, not only on the container's range flag.
float3 mk_nativeLog(float3 expanded, constant mk_FrameParams& f) {
  bool full = f.options.y != 0, rescaled = f.options.z != 0;
  if (full) return rescaled ? mk_unsqueezeLegal(expanded * f.levels.y, f) : expanded;
  return rescaled ? expanded : (expanded * 876 + 64) / 1023;
}

float mk_nativeLog(float expanded, constant mk_FrameParams& f) { return mk_nativeLog(float3(expanded), f).x; }

#endif
