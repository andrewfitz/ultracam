// MonitorKit picture pass. Compiled after MKLUT.msl and MKDecode.msl.
#include <metal_stdlib>
using namespace metal;

// Tool tiers. MonitorEngine binds each to a function constant and builds one
// pipeline per tool set, so a surface pays only for the tools it shows (dead
// code still costs registers and occupancy). Compiled on its own, every tier is on.
#ifndef MK_LUTS
#define MK_LUTS 3u            // bit 0: the burn-in LUT is read, bit 1: the monitor LUT
#endif
#ifndef MK_ADJUST
#define MK_ADJUST true        // display adjustments other than identity
#endif
// An *_srgb target. The engine fixes it per pipeline: a run-time branch around
// the decode measurably slows every pixel, even when not taken.
#ifndef MK_SRGB_TARGET
#define MK_SRGB_TARGET (p.flags.z != 0)
#endif
#ifndef MK_ZEBRAS
#define MK_ZEBRAS true        // either zebra set
#endif
#ifndef MK_PEAKING
#define MK_PEAKING true       // focus peaking
#endif
#ifndef MK_GUIDES
#define MK_GUIDES true        // guide strokes and matte
#endif
#ifndef MK_FALSE_COLOR
#define MK_FALSE_COLOR 3u     // bit 0: log modes, bit 1: stage modes
#endif
#ifndef MK_INTERPOLATES
#define MK_INTERPOLATES true  // some footprint is under a picture pixel: bicubic
#endif
#ifndef MK_NAVIGATOR
#define MK_NAVIGATOR true     // the magnification inset
#endif
#ifndef MK_CLIP
#define MK_CLIP true          // clip indicators
#endif
// Output colour (MonitorKitCore.MonitorColorPipeline). The engine fixes each per
// pipeline; compiled on its own they follow the uniforms, so a host that prepends
// this file gets the same pixels.
#ifndef MK_TRANSFORM
#define MK_TRANSFORM (p.color.x)         // display transform: 0 none, 1 log to Rec.709, 2 PQ to SDR, 3 HLG to SDR
#endif
#ifndef MK_PICTURE_TF
#define MK_PICTURE_TF (p.color.y)        // the picture's transfer: 1 BT.1886, 2 sRGB, 3 gamma 2.2, 4 linear, 5 PQ, 6 HLG
#endif
#ifndef MK_TARGET_TF
#define MK_TARGET_TF (p.color.z)         // the target's transfer, same codes; 0 writes the picture unchanged
#endif
#ifndef MK_ROLLOFF
#define MK_ROLLOFF (p.colorFlags.x != 0) // highlight roll-off before the target encode
#endif
// The stage the picture shows: 0 source, 1 output (burn-in LUT), 2 monitor (both
// LUTs). The engine fixes it per pipeline; compiled on its own it follows the uniforms.
#ifndef MK_PICTURE_STAGE
#define MK_PICTURE_STAGE (uint(p.falseColor.z))
#endif
// The display assist's log curve (luts.z codes: 1 S-Log3, 2 LogC3, 3 LogC4). The
// engine fixes it per pipeline; compiled on its own it follows the uniforms.
#ifndef MK_LOG_CURVE
#define MK_LOG_CURVE (p.luts.z)
#endif

// ---------------------------------------------------------------- transfers

// Sony S-Log3 technical summary: normalized native code to scene reflectance.
float mk_sLog3Decode(float v) {
  float code = v * 1023;
  return code >= 171.2102946929f ? pow(10.0f, (code - 420) / 261.5f) * .19f - .01f
                                 : (code - 95) * .01125f / (171.2102946929f - 95);
}
// ARRI LogC3 EI800 (ALEXA LogC curve, 2017 white paper).
float mk_logC3Decode(float v) {
  return v > 5.367655f * .010591f + .092809f ? (pow(10.0f, (v - .385537f) / .247190f) - .052272f) / 5.555556f : (v - .092809f) / 5.367655f;
}
// ARRI LogC4 (ALEXA 35 LogC4 specification, 2022).
float mk_logC4Decode(float v) {
  const float a = (262144.0f - 16) / 117.45f, b = (1023.0f - 95) / 1023, c = 95.0f / 1023;
  const float s = (7 * M_LN2_F * exp2(7 - 14 * c / b)) / (a * b), t = (exp2(14 * (-c / b) + 6) - 64) / a;
  return v >= 0 ? (exp2(14 * (v - c) / b + 6) - 64) / a : v * s + t;
}
// curve: 1 S-Log3, 2 LogC3, 3 LogC4 (LogCurve order + 1).
float3 mk_logDecode(float3 v, uint curve) {
  if (curve == 2) return float3(mk_logC3Decode(v.r), mk_logC3Decode(v.g), mk_logC3Decode(v.b));
  if (curve == 3) return float3(mk_logC4Decode(v.r), mk_logC4Decode(v.g), mk_logC4Decode(v.b));
  return float3(mk_sLog3Decode(v.r), mk_sLog3Decode(v.g), mk_sLog3Decode(v.b));
}
// The LogC3 EI800 encode as full 10-bit code: the ARRI-style reference on S-Log3.
float mk_logC3ReferenceCode(float y) {
  return (y > .010591f ? .247190f * log10(5.555556f * y + .052272f) + .385537f : 5.367655f * y + .092809f) * 1023;
}
// ITU-R BT.709 inverse OETF.
float mk_bt709Linear(float v) { return v < .081f ? v / 4.5f : pow((v + .099f) / 1.099f, 1 / .45f); }
// IEC 61966-2-1 decode.
float3 mk_srgbDecode(float3 v) { return select(pow((v + .055f) / 1.055f, 2.4f), v / 12.92f, v <= .04045f); }
// SMPTE ST 2084 EOTF, in cd/m², on its 0…1 domain (above it the denominator falls to 0).
float mk_pqNits(float e) {
  const float m1 = 2610.0f / 16384, m2 = 2523.0f / 4096 * 128, c1 = 3424.0f / 4096, c2 = 2413.0f / 4096 * 32, c3 = 2392.0f / 4096 * 32;
  float p = pow(saturate(e), 1 / m2);
  return 10000 * pow(max(p - c1, 0.0f) / (c2 - c3 * p), 1 / m1);
}
// ITU-R BT.2100 HLG inverse OETF.
float mk_hlgInverseOETF(float e) {
  const float a = .17883277f, b = 1 - 4 * a, c = .5f - a * log(4 * a);
  e = max(e, 0.0f);
  return e <= .5f ? e * e / 3 : (exp((e - c) / a) + b) / 12;
}
// Relative light with the 18% grey card at 0.18 (DisplayTransfer.exposureLinear).
// transfer: 0 BT.709, 1 sRGB, 2 PQ, 3 HLG, 4 linear.
float mk_exposureLinear(float v, uint transfer) {
  if (transfer == 1) return mk_srgbDecode(float3(v)).x;
  if (transfer == 2) return mk_pqNits(v) * (.18f / 26);                          // BT.2408 grey card: 26 cd/m²
  if (transfer == 3) return mk_hlgInverseOETF(v) * (.18f / (.38f * .38f / 3));    // BT.2408 grey card: 38% HLG
  if (transfer == 4) return v;
  return mk_bt709Linear(v);
}
// The log curve's signal value from range-expanded values (LogCurve.signal):
// S-Log3 is defined on 10-bit codes in any container; LogC fills the container's range.
float3 mk_logSignal(float3 expanded, uint curve, constant mk_FrameParams& f) {
  if (curve == 1) return mk_nativeLog(expanded, f);
  return f.options.y != 0 && f.options.z != 0 ? mk_unsqueezeLegal(expanded * f.levels.y, f) : expanded;
}

inline float mk_luma709(float3 c) { return mk_luma(c, float3(.2126f, .7152f, .0722f)); }

// ---------------------------------------------------------------- output colour transfers
// Mirrors MonitorKitCore's TransferFunctions.swift. These run on every displayed
// pixel of an encoding other than signal-native, so they use the hardware's fast
// exp2/log2 (relative error about 1e-6, far under a 12-bit code; the GPU-vs-CPU
// tests bound it) instead of the library's safe-mode pow. For the same reason a
// quotient of run-time values uses fast::divide (2.5 ulp, against a correctly
// rounded division's long sequence: a fifth of the PQ encode) and a constant
// divisor is a multiplication by its reciprocal.

inline float3 mk_powf(float3 x, float3 y) { return fast::pow(x, y); }
inline float mk_powf(float x, float y) { return fast::pow(x, y); }
inline float3 mk_div(float3 x, float3 y) { return fast::divide(x, y); }
inline float mk_div(float x, float y) { return fast::divide(x, y); }
// sign(v)·|v|^e: the SDR curves mirrored about zero (Report ITU-R BT.2408-8 §5.3).
inline float3 mk_mirrorPow(float3 v, float e) { return sign(v) * mk_powf(abs(v), float3(e)); }
// ITU-R BT.709 OETF; 0 below zero.
float3 mk_bt709OETF(float3 l) {
  return select(1.099f * mk_powf(max(l, .018f), float3(.45f)) - .099f, 4.5f * max(l, 0.0f), l < .018f);
}
// SMPTE ST 2084 (BT.2100 Table 4): the EOTF in cd/m² (signal clipped to its 0…1
// domain, so super-whites stop at 10 000 cd/m² and nothing is NaN), and its inverse.
constant float MK_PQ_M1 = 2610.0f / 16384, MK_PQ_M2 = 2523.0f / 4096 * 128, MK_PQ_C1 = 3424.0f / 4096,
               MK_PQ_C2 = 2413.0f / 4096 * 32, MK_PQ_C3 = 2392.0f / 4096 * 32;
float3 mk_pqNits3(float3 e) {
  float3 q = mk_powf(saturate(e), float3(1 / MK_PQ_M2));
  return 10000 * mk_powf(mk_div(max(q - MK_PQ_C1, 0.0f), MK_PQ_C2 - MK_PQ_C3 * q), float3(1 / MK_PQ_M1));
}
float mk_pqNits1(float e) {
  float q = mk_powf(saturate(e), 1 / MK_PQ_M2);
  return 10000 * mk_powf(mk_div(max(q - MK_PQ_C1, 0.0f), MK_PQ_C2 - MK_PQ_C3 * q), 1 / MK_PQ_M1);
}
float3 mk_pqSignal(float3 nits) {
  float3 y = mk_powf(clamp(nits, 0.0f, 10000.0f) * (1.0f / 10000), float3(MK_PQ_M1));
  return mk_powf(mk_div(MK_PQ_C1 + MK_PQ_C2 * y, 1 + MK_PQ_C3 * y), float3(MK_PQ_M2));
}
float mk_pqSignal1(float nits) {
  float y = mk_powf(clamp(nits, 0.0f, 10000.0f) * (1.0f / 10000), MK_PQ_M1);
  return mk_powf(mk_div(MK_PQ_C1 + MK_PQ_C2 * y, 1 + MK_PQ_C3 * y), MK_PQ_M2);
}
// ITU-R BT.2100 Table 5 HLG OETF (scene light clipped to 0…1, as the signal holds
// no more) and its inverse.
float3 mk_hlgOETF(float3 e) {
  const float a = .17883277f, b = 1 - 4 * a, c = .5f - a * log(4 * a);
  e = saturate(e);
  return select(a * fast::log(max(12 * e - b, 1e-6f)) + c, sqrt(3 * e), e <= 1.0f / 12);
}
float3 mk_hlgInverseOETF3(float3 e) {
  const float a = .17883277f, b = 1 - 4 * a, c = .5f - a * log(4 * a);
  e = max(e, 0.0f);
  return select((fast::exp((e - c) * (1 / a)) + b) * (1.0f / 12), e * e * (1.0f / 3), e <= .5f);
}
// BT.2100 HLG OOTF (black lift 0), F = peak·Ys^(γ-1)·E in cd/m², and its inverse
// E = F / (peak·Ys^(γ-1)) with Ys = (Yd/peak)^(1/γ), as F·peak⁻¹·(Yd/peak)^((1-γ)/γ).
float3 mk_hlgOOTF(float3 e, float peak, float gamma, float3 w) {
  float ys = dot(w, e);
  return ys > 0 ? e * (peak * mk_powf(ys, gamma - 1)) : float3(0);
}
float3 mk_hlgInverseOOTF(float3 f, float peak, float gamma, float3 w) {
  float yd = dot(w, f);
  if (yd <= 0) return float3(0);
  float inverse = mk_div(1.0f, peak);
  return f * (inverse * mk_powf(yd * inverse, mk_div(1 - gamma, gamma)));
}
// Report ITU-R BT.2408-8 Annex 5 EETF on PQ signal normalized to the source peak
// (black levels 0): 1:1 below the knee, then the Hermite spline to maxLum.
float mk_eetf(float e1, float4 t) {
  if (t.w != 0 || e1 < t.z) return e1;
  // A knee that rounds to 1 (a target a hair under the source peak) leaves no span
  // to divide by: at and above it the curve is maxLum, as in Double.
  if (t.z >= 1) return t.y;
  float x = mk_div(min(e1, 1.0f) - t.z, 1 - t.z), x2 = x * x, x3 = x2 * x;
  return (2 * x3 - 3 * x2 + 1) * t.z + (x3 - 2 * x2 + x) * (1 - t.z) + (-2 * x3 + 3 * x2) * t.y;
}
// The EETF's maxRGB application to cd/m²: it keeps the target colour volume.
float3 mk_toneMap(float3 nits, float4 t) {
  float m = max3(nits.r, nits.g, nits.b);
  if (t.w != 0 || m <= 0) return nits;
  return nits * mk_div(mk_pqNits1(mk_eetf(mk_div(mk_pqSignal1(m), t.x), t) * t.x), m);
}
// mk_toneMap of PQ-decoded `nits` given the PQ signal of their maxRGB. The EOTF is
// monotonic, so that is the largest source code: no re-encode (two fewer pow).
float3 mk_toneMapPQ(float3 nits, float maxSignal, float4 t) {
  float m = max3(nits.r, nits.g, nits.b);
  if (t.w != 0 || m <= 0) return nits;
  return nits * mk_div(mk_pqNits1(mk_eetf(mk_div(maxSignal, t.x), t) * t.x), m);
}
inline float3 mk_rows(constant float4* m, float3 c) { return float3(dot(m[0].xyz, c), dot(m[1].xyz, c), dot(m[2].xyz, c)); }

// ---------------------------------------------------------------- parameters

// Mirrors MonitorKit.PassParameters. 16-byte rows; the Swift test checks every offset.
struct mk_PassParams {
  float4 displayToPicture;   // scaleX, scaleY, offsetX, offsetY: viewport pixel -> picture pixel
  float4 imageRect;          // x, y, maxX, maxY in viewport pixels
  float4 navigatorRect;      // empty when x >= maxX
  float4 navigatorToPicture;
  float4 navigatorVisible;   // the visible region, in viewport pixels inside the navigator
  float4 viewport;           // x, y, width, height of the viewport in the target
  float4 guideRect;          // the picture guides follow; the matte darkens it outside `matte`
  float4 matte;              // empty when x >= maxX
  float4 zebra0;             // lower IRE (inclusive), upper IRE (exclusive), opacity, stripe value
  float4 zebra1;
  uint4  zebra;              // x: set 0 stage, y: set 1 stage, z: bit 0 set 0 on, bit 1 set 1 on, w: stripe period px
  uint4  modes;              // x: false colour measure (0 off), y: stage, z: band count, w: integral 10-bit restore
  float4 falseColor;         // x: offset stops, y: ARRI tables are full range, z: picture stage (0 source, 1 output, 2 monitor)
  float4 gamutWeights;       // scene-linear luminance weights of the source gamut
  float4 focus;              // x: opacity, y: style (0 edges, 1 peak), z: on
  float4 focusColor;
  float4 guide;              // x: opacity, y: outline opacity, z: on, w: matte opacity
  float4 guideColor;         // w: guide lines present
  float4 display;            // brightness, contrast, saturation, monochrome (0 off, 1 luma, 2 blue)
  uint4  flags;              // x: nearest sampling, y: display adjustments are identity, z: sRGB target, w: clean
  uint4  luts;               // x: burn-in LUT on, y: monitor LUT on, z: source log curve (0 none, 1 S-Log3, 2 LogC3, 3 LogC4), w: source transfer (mk_exposureLinear)
  float4 bandEdges[16];      // x: lower inclusive, y: upper exclusive
  float4 bandColors[16];     // in target values
  uint4  color;              // x: display transform, y: picture transfer, z: target transfer (0 none), w: overlay transfer (0 as authored; CPU only)
  uint4  colorFlags;         // x: roll-off, y: clip indicators on, z: clip channels (bit 0 R, 1 G, 2 B, 3 Y'), w: clip stage
  float4 colorLevels;        // x: graphics white cd/m², y: its inverse, z: HLG output peak cd/m², w: its system gamma
  float4 hlgSource;          // x: HLG decode peak cd/m², y: its system gamma, z: 1 / scene light of 75% HLG
  float4 toneMap;            // BT.2408 Annex 5 EETF: x: PQ signal of the source peak, y: maxLum, z: knee start, w: identity
  float4 assist;             // display assist v1: x: knee scene light, y: knee signal, z: shoulder exponent, w: log2(x)
  float4 pictureWeights;     // luminance weights of the picture primaries (HLG OOTF)
  float4 targetWeights;      // luminance weights of the target (or overlay) primaries (HLG inverse OOTF)
  float4 toTarget[3];        // rows: linear picture primaries to target primaries
  float4 transformMatrix[3]; // rows: linear source gamut to Rec.709 for the display transforms
  float4 overlayWhite;       // graphics white in target values
  float4 zebraColors[2];     // stripe colours of sets 1 and 2, in target values
  float4 navigatorColors[2]; // frame, visible box
  float4 clipLevels;         // x: over at or above (percent; +inf off), y: under at or below (-inf off), z: opacity
  float4 clipColors[16];     // 0-7 over, 8-15 under, by flagged channel bits (0: luma alone)
  float4 whiteGain;          // white-point trim: xyz linear-light gains in the picture primaries, w: picture transfer (0 off)
  float4 whiteSignalGain;    // the same gains on the signal of a power-law picture (BT.1886, gamma 2.2, linear)
  float4 reciprocals;        // correctly rounded: x: 1 / luma span (levels.y), y: 1 / chroma span (levels.w), z: 1 / kg (matrix.y), w: 1 / zebra stripe period; 0: computed here
};

// Mirrors MonitorKit.GuideParameters: guide strokes in viewport pixels, drawn
// analytically (no line texture). Axis-aligned strokes are sorted along their
// position so a pixel tests only the few within reach.
struct mk_Guides {
  uint4 counts;              // x: verticals, y: horizontals, z: others
  float4 reach;              // x: search radius (widest half width + outline + 1), y: outline width
  float4 lines[128];         // verticals (x, y0, y1, half width) by x, then horizontals (y, x0, x1, half width) by y
  float4 others[16];         // pairs: (x0, y0, x1, y1), (half width, 0, 0, 0); a zero-length one is a round dot
  uint cells[64];            // bit k of words 0-31: a vertical reaches x in [16k, 16k + 16); 32-63: horizontals, by y
};

// Whether an axis-aligned stroke may be within reach of position v along `axis`:
// most pixels are far from every line and skip the search (positions beyond the
// table always search).
inline bool mk_guideCell(float v, uint axis, constant mk_Guides& g) {
  uint k = uint(max(v, 0.0f)) / 16;
  return k >= 1024 || ((g.cells[axis * 32 + k / 32] >> (k % 32)) & 1) != 0;
}

// False colour measures (modes.x).
constant uint MK_FC_OFF = 0, MK_FC_SONY = 1, MK_FC_ARRI_STYLE = 2, MK_FC_ARRI_LOGC = 3, MK_FC_ELZONE = 4,
              MK_FC_STAGE_IRE = 5, MK_FC_STAGE_STOPS = 6;

struct mk_Inputs {
  texture2d<uint, access::read> packed;
  texture2d<float, access::read> luma;
  texture2d<float, access::read> chroma;
  texture3d<float, access::sample> burnLUT;
  texture3d<float, access::sample> monitorLUT;
  constant mk_FrameParams& frame;
  constant mk_LUTParams& burn;
  constant mk_LUTParams& monitor;
  constant mk_PassParams& pass;
};

// ---------------------------------------------------------------- v210 in the picture pass
// MKDecode's v210 reads with the lanes picked by selects of constant shifts: in
// this pass they cost a fifth less than MKDecode's indexed form (whose focus
// kernel is faster with it), and the same codes come out.

inline float mk_v210LumaLane(uint4 g, uint n) {
  uint w = n == 0 ? g.x : (n <= 2 ? g.y : (n == 3 ? g.z : g.w));
  return float((w >> (n == 0 || n == 3 ? 10 : (n == 2 || n == 5 ? 20 : 0))) & 1023);
}
// Cb of lane l is word l at bit 10l; Cr is word 0, 2, 3 at bit 20, 0, 10.
inline float2 mk_v210ChromaLane(uint4 g, uint l) {
  uint cb = l == 0 ? g.x : (l == 1 ? g.y >> 10 : g.z >> 20);
  uint cr = l == 0 ? g.x >> 20 : (l == 1 ? g.z : g.w >> 10);
  return float2(cb & 1023, cr & 1023);
}

// Whether pixel x is in the last chroma pair of its row (no chroma sample after it).
inline bool mk_v210LastPair(uint x, constant mk_FrameParams& f) { return x / 2 + 1 >= (f.shape.y + 1) / 2; }

// mk_v210NextChroma with these lanes.
inline float2 mk_v210NextLane(texture2d<uint, access::read> packed, uint4 g, uint l, uint2 xy,
                              constant mk_FrameParams& f) {
  if (mk_v210LastPair(xy.x, f)) return mk_v210ChromaLane(g, l);
  return l < 2 ? mk_v210ChromaLane(g, l + 1) : mk_v210ChromaLane(packed.read(uint2(xy.x / 6 + 1, xy.y)), 0);
}

// mk_v210Codes: pixel xy of left-sited v210; an odd pixel of lane 2 reads the next group.
float3 mk_v210PixelCodes(texture2d<uint, access::read> packed, uint2 xy, constant mk_FrameParams& f) {
  uint4 g = packed.read(uint2(xy.x / 6, xy.y));
  uint n = xy.x % 6;
  float2 c = mk_v210ChromaLane(g, n / 2);
  if (n & 1) c = mix(c, mk_v210NextLane(packed, g, n / 2, xy, f), .5f);
  return float3(mk_v210LumaLane(g, n), c);
}

// mk_v210PairCodes: pixels x, x + 1 (x even) of a left-sited v210 row.
float3 mk_v210PixelPairCodes(texture2d<uint, access::read> packed, uint2 xy, constant mk_FrameParams& f) {
  uint4 g = packed.read(uint2(xy.x / 6, xy.y));
  uint n = xy.x % 6;
  float2 c = mix(mk_v210ChromaLane(g, n / 2), mk_v210NextLane(packed, g, n / 2, xy, f), .25f);
  return float3((mk_v210LumaLane(g, n) + mk_v210LumaLane(g, n + 1)) * .5f, c);
}

// A row's taps move only right, so a filter row keeps the group under its tap and
// the one after it, each read once per row instead of once or twice per tap.
struct mk_V210Row {
  uint4 group, next;
  uint index, last, y;
};

mk_V210Row mk_v210Row(texture2d<uint, access::read> packed, uint x, uint y, constant mk_FrameParams& f) {
  mk_V210Row r;
  r.index = x / 6;
  r.last = (f.shape.y - 1) / 6;
  r.y = y;
  r.group = packed.read(uint2(r.index, y));
  r.next = packed.read(uint2(min(r.index + 1, r.last), y));
  return r;
}

void mk_v210Advance(thread mk_V210Row& r, uint x, texture2d<uint, access::read> packed) {
  while (x / 6 > r.index) {
    r.index++;
    r.group = r.next;
    r.next = packed.read(uint2(min(r.index + 1, r.last), r.y));
  }
}

// The chroma after pixel x's lane (lane l of r.group): the next lane, or the next group's first.
inline float2 mk_v210RowAfter(thread const mk_V210Row& r, uint x, uint l, float2 c, constant mk_FrameParams& f) {
  return mk_v210LastPair(x, f) ? c : (l < 2 ? mk_v210ChromaLane(r.group, l + 1) : mk_v210ChromaLane(r.next, 0));
}

// mk_v210PixelCodes of pixel x of the row, centred chroma (mk_tapCodes).
float3 mk_v210RowCodes(thread mk_V210Row& r, uint x, texture2d<uint, access::read> packed, constant mk_FrameParams& f) {
  mk_v210Advance(r, x, packed);
  uint n = x % 6, l = n / 2;
  float2 c = mk_v210ChromaLane(r.group, l);
  if (n & 1) c = mix(c, mk_v210RowAfter(r, x, l, c, f), .5f);
  return float3(mk_v210LumaLane(r.group, n), c - f.levels.z);
}

// mk_v210PixelPairCodes of pixels x, x + 1 of the row, centred chroma (mk_pairCodes).
float3 mk_v210RowPairCodes(thread mk_V210Row& r, uint x, texture2d<uint, access::read> packed, constant mk_FrameParams& f) {
  mk_v210Advance(r, x, packed);
  uint n = x % 6, l = n / 2;
  float2 c = mk_v210ChromaLane(r.group, l);
  c = mix(c, mk_v210RowAfter(r, x, l, c, f), .25f);
  return float3((mk_v210LumaLane(r.group, n) + mk_v210LumaLane(r.group, n + 1)) * .5f, c - f.levels.z);
}

// ---------------------------------------------------------------- sampling

uint2 mk_clampPixel(float2 p, constant mk_FrameParams& f) {
  return uint2(clamp(floor(p), float2(0), float2(f.shape.y - 1, f.shape.z - 1)));
}

// Codes of pixel xy for code-space filtering: (Y', Cb - centre, Cr - centre) in
// stored codes, or the stored RGB. Decoding is affine in these, so a weighted sum
// of codes decodes to the same weighted sum of pictures with one conversion, and
// centred chroma keeps neutral sums exactly neutral.
float3 mk_tapCodes(uint2 xy, thread const mk_Inputs& in) {
  constant mk_FrameParams& f = in.frame;
  if (MK_LAYOUT(f) == MK_RGB) return in.luma.read(xy).rgb;
  float3 c = MK_LAYOUT(f) == MK_V210 && !f.options.x
               ? mk_v210PixelCodes(in.packed, xy, f)
               : float3(mk_lumaCode(in.packed, in.luma, xy, f), mk_chromaCode(in.packed, in.chroma, xy, f));
  return float3(c.x, c.yz - f.levels.z);
}

// Codes averaged over pixels x, x + 1 of a left-sited packed 4:2:2 row (x even):
// one texel read (two at a group's last pair) serves both pixels.
float3 mk_pairCodes(uint2 xy, thread const mk_Inputs& in) {
  constant mk_FrameParams& f = in.frame;
  float3 c;
  if (MK_LAYOUT(f) == MK_V210) {
    c = mk_v210PixelPairCodes(in.packed, xy, f);
  } else {
    uint2 t = uint2(xy.x / 2, xy.y);
    uint4 a = in.packed.read(t);
    uint4 b = t.x + 1 < (f.shape.y + 1) / 2 ? in.packed.read(t + uint2(1, 0)) : a;
    bool uyvy = MK_LAYOUT(f) == MK_UYVY8;
    float2 ca = uyvy ? float2(a.r, a.b) : float2(a.g, a.a), cb = uyvy ? float2(b.r, b.b) : float2(b.g, b.a);
    c = float3((uyvy ? float(a.g) + float(a.a) : float(a.r) + float(a.b)) * .5f, mix(ca, cb, .25f));
  }
  return float3(c.x, c.yz - f.levels.z);
}

// mk_decode of codes (mk_tapCodes' form). The quotients by the frame's spans use
// their reciprocals (`inverse`: x luma span, y chroma span, z kg): the same values
// as MKDecode's divisions at a fraction of the cost. Float RGB keeps its values.
float4 mk_decodeCodes(float3 c, constant mk_FrameParams& f, float3 inverse) {
  if (MK_LAYOUT(f) == MK_RGB) {
    float3 rgb = c;
    if (f.codeScale.w == 0 && !f.options.y) rgb = mk_quotient(rgb * f.codeScale.z - f.levels.x, f.levels.y, inverse.x);
    return float4(rgb, mk_luma(rgb, f.matrix.xyz));
  }
  float y = mk_quotient(c.x - f.levels.x, f.levels.y, inverse.x);
  return float4(mk_ycbcrToRGB(y, mk_quotient(c.yz, f.levels.w, inverse.y), f.matrix, inverse.z), y);
}

// The mean of `count` filter taps' codes: an exact quotient by the count (its
// reciprocal is the axis's), except float RGB, whose values may be non-finite.
inline float3 mk_mean(float3 sum, float count, float inverse, constant mk_FrameParams& f) {
  return MK_LAYOUT(f) == MK_RGB && f.codeScale.w != 0 ? sum / count : mk_quotient(sum, count, inverse);
}

// One axis of the filter: `count` taps from `first`, `step` apart.
struct mk_Axis { float first, step; uint count; bool cubic; float4 w; float inverse; };

// Nearest for an exact 1:1 or when asked; Catmull-Rom (Keys 1981, a = -1/2) when
// magnified, the sharp interpolating bicubic; otherwise a box of bounded
// stratified taps, exact for integral minification.
mk_Axis mk_axis(float centre, float footprint, bool nearest, uint maxTaps) {
  mk_Axis a = {centre, 0, 1, false, float4(1, 0, 0, 0), 1};
  if (nearest || footprint == 1) return a;
  if (MK_INTERPOLATES && footprint < 1) {
    float p = centre - .5f, base = floor(p), t = p - base, t2 = t * t, t3 = t2 * t;
    a.first = base - .5f;
    a.step = 1;
    a.count = 4;
    a.cubic = true;
    a.w = float4(2 * t2 - t3 - t, 3 * t3 - 5 * t2 + 2, 4 * t2 - 3 * t3 + t, t3 - t2) * .5f;
    return a;
  }
  a.count = uint(clamp(ceil(footprint - .001f), 1.0f, float(maxTaps)));
  a.inverse = 1.0f / float(a.count);
  a.step = mk_quotient(footprint, float(a.count), a.inverse);
  a.first = centre - footprint * .5f + a.step * .5f;
  return a;
}

// Catmull-Rom as an offset from tap 1 (whose weight is 1 minus the others), so
// a flat area stays exactly flat: the weights' rounding cannot move it.
inline float3 mk_cubic(float3 c0, float3 c1, float3 c2, float3 c3, float4 w) {
  return c1 + w.x * (c0 - c1) + w.z * (c2 - c1) + w.w * (c3 - c1);
}

// One row of the filter at picture row y, in codes.
float3 mk_row(uint y, thread const mk_Axis& ax, bool pairs, thread const mk_Inputs& in) {
  constant mk_FrameParams& f = in.frame;
  bool v210 = MK_LAYOUT(f) == MK_V210 && !f.options.x;
  uint x0 = mk_clampPixel(float2(ax.first, 0), f).x;
  float3 c[4];
  if (ax.cubic) {
    if (v210) {
      mk_V210Row r = mk_v210Row(in.packed, x0, y, f);
      for (uint i = 0; i < 4; i++)
        c[i] = mk_v210RowCodes(r, mk_clampPixel(float2(ax.first + float(i), 0), f).x, in.packed, f);
    } else {
      for (uint i = 0; i < 4; i++) c[i] = mk_tapCodes(uint2(mk_clampPixel(float2(ax.first + float(i), 0), f).x, y), in);
    }
    return mk_cubic(c[0], c[1], c[2], c[3], ax.w);
  }
  float3 sum = 0;
  if (pairs) {
    // Whole-pixel box on left-sited packed 4:2:2: pixel pairs share a texel. A
    // single pair reads only what it needs; more share the row's groups.
    if (v210 && ax.count > 2) {
      mk_V210Row r = mk_v210Row(in.packed, x0, y, f);
      for (uint i = 0; i < ax.count; i += 2) sum += mk_v210RowPairCodes(r, x0 + i, in.packed, f);
    } else {
      for (uint i = 0; i < ax.count; i += 2) sum += mk_pairCodes(uint2(x0 + i, y), in);
    }
    return mk_mean(sum * 2, float(ax.count), ax.inverse, f);
  }
  // A single tap (an axis at 1:1 under an anisotropic footprint) reads only what it needs.
  if (v210 && ax.count > 1) {
    mk_V210Row r = mk_v210Row(in.packed, x0, y, f);
    for (uint i = 0; i < ax.count; i++)
      sum += mk_v210RowCodes(r, mk_clampPixel(float2(ax.first + float(i) * ax.step, 0), f).x, in.packed, f);
  } else {
    for (uint i = 0; i < ax.count; i++)
      sum += mk_tapCodes(uint2(mk_clampPixel(float2(ax.first + float(i) * ax.step, 0), f).x, y), in);
  }
  return mk_mean(sum, float(ax.count), ax.inverse, f);
}

// Source R'G'B' and transport Y' over the picture footprint of display pixel `d`
// (its centre is i + 0.5), filtered separably in code space and decoded once.
// The LUTs run once on the result, not per tap.
float4 mk_filtered(float2 d, float4 map, bool nearest, uint maxTaps, thread const mk_Inputs& in) {
  constant mk_FrameParams& f = in.frame;
  float2 centre = d * map.xy + map.zw, footprint = abs(map.xy);
  mk_Axis ax = mk_axis(centre.x, footprint.x, nearest, maxTaps), ay = mk_axis(centre.y, footprint.y, nearest, maxTaps);
  // The frame's reciprocals from the uniforms (MonitorPass sets them), else here.
  float3 inverse = in.pass.reciprocals.x != 0 ? in.pass.reciprocals.xyz
                                               : float3(1.0f / f.levels.y, 1.0f / f.levels.w, 1.0f / f.matrix.y);
  if (ax.count == 1 && ay.count == 1) return mk_decodeCodes(mk_tapCodes(mk_clampPixel(centre, f), in), f, inverse);
  bool packed422 = MK_LAYOUT(f) == MK_V210 || MK_LAYOUT(f) == MK_UYVY8 || MK_LAYOUT(f) == MK_YUYV8;
  uint x0 = mk_clampPixel(float2(ax.first, 0), f).x;
  bool pairs = packed422 && !f.options.x && !ax.cubic && ax.step == 1 && (ax.count & 1) == 0 && ax.first >= 0
               && (x0 & 1) == 0 && x0 + ax.count <= f.shape.y;
  float3 codes;
  if (ay.cubic) {
    float3 r[4];
    for (uint j = 0; j < 4; j++) r[j] = mk_row(mk_clampPixel(float2(0, ay.first + float(j)), f).y, ax, pairs, in);
    codes = mk_cubic(r[0], r[1], r[2], r[3], ay.w);
  } else {
    float3 sum = 0;
#pragma clang loop unroll(disable)
    for (uint j = 0; j < ay.count; j++) sum += mk_row(mk_clampPixel(float2(0, ay.first + float(j) * ay.step), f).y, ax, pairs, in);
    codes = mk_mean(sum, float(ay.count), ay.inverse, f);
  }
  return mk_decodeCodes(codes, f, inverse);
}

// Source, output (after the burn-in LUT) and monitor (after the monitor LUT) values.
struct mk_Stages { float3 source, output, monitor; float sourceLuma; };

mk_Stages mk_stages(float4 decoded, thread const mk_Inputs& in) {
  mk_Stages s;
  s.source = decoded.rgb;
  s.sourceLuma = decoded.w;
  float3 c = s.source;
  if ((MK_LUTS & 1) != 0 && in.pass.luts.x != 0) c = mk_applyLUT(c, in.burnLUT, in.burn);
  s.output = c;
  if ((MK_LUTS & 2) != 0 && in.pass.luts.y != 0) c = mk_applyLUT(c, in.monitorLUT, in.monitor);
  s.monitor = c;
  return s;
}

float3 mk_stage(thread const mk_Stages& s, uint stage) { return stage == 0 ? s.source : (stage == 1 ? s.output : s.monitor); }

// Whether a LUT produced the stage's value.
bool mk_stageIsLUT(uint stage, constant mk_PassParams& p) {
  return ((MK_LUTS & 2) != 0 && stage == 2 && p.luts.y != 0) || ((MK_LUTS & 1) != 0 && stage >= 1 && p.luts.x != 0);
}

// Y' of a stage. The source and anything no LUT has touched use the transport
// luma; LUT results are display R'G'B', weighted as Rec.709.
float mk_stageLuma(thread const mk_Stages& s, uint stage, constant mk_PassParams& p) {
  if (!mk_stageIsLUT(stage, p)) return s.sourceLuma;
  return mk_luma709(stage == 2 && p.luts.y != 0 ? s.monitor : s.output);
}

// mk_logSignal for the display transform, which runs on every pixel: constant
// divisors as reciprocals and fast::divide (false colour keeps the exact form).
float3 mk_logSignalFast(float3 expanded, uint curve, constant mk_FrameParams& f) {
  bool full = f.options.y != 0, rescaled = f.options.z != 0;
  // mk_unsqueezeLegal: (code - 16s) / 219s with s = 2^(n-8).
  float scale = (f.levels.y + 1) * (1.0f / 256);
  float3 unsqueezed = (expanded * f.levels.y - 16 * scale) * mk_div(1.0f, 219 * scale);
  if (curve == 1 && !full) return rescaled ? expanded : (expanded * 876 + 64) * (1.0f / 1023);
  return full && rescaled ? unsqueezed : expanded;
}

// The camera log decodes (mk_logDecode) with fast exp2, for the display transform,
// which runs on every pixel; false colour keeps the exact ones.
float3 mk_logDecodeFast(float3 v, uint curve) {
  if (curve == 2) {
    // LogC3 EI 800: (10^((t - d)/c) - b)/a above the cut, linear below.
    float3 high = (fast::exp2((v - .385537f) * (M_LOG2E_F * M_LN10_F / .247190f)) - .052272f) * (1 / 5.555556f);
    return select((v - .092809f) * (1 / 5.367655f), high, v > 5.367655f * .010591f + .092809f);
  }
  if (curve == 3) {
    const float a = (262144.0f - 16) / 117.45f, b = (1023.0f - 95) / 1023, c = 95.0f / 1023;
    const float s = (7 * M_LN2_F * exp2(7 - 14 * c / b)) / (a * b), t = (exp2(14 * (-c / b) + 6) - 64) / a;
    return select(v * s + t, (fast::exp2((v - c) * (14 / b) + 6) - 64) * (1 / a), v >= 0);
  }
  // S-Log3: 10^((code - 420)/261.5)·0.19 - 0.01 from code 171.2102946929, linear below.
  float3 code = v * 1023;
  float3 high = fast::exp2((code - 420) * (M_LOG2E_F * M_LN10_F / 261.5f)) * .19f - .01f;
  return select((code - 95) * (.01125f / (171.2102946929f - 95)), high, code >= 171.2102946929f);
}

// ---------------------------------------------------------------- output colour
// Mirrors MonitorKitCore.MonitorColorPipeline: display transform → adjustments →
// decode the picture transfer to linear light (1 = graphics white) → primaries →
// optional roll-off → target encode. Overlays are then mixed in target values.

// The monitor stage (in the source's encoding) to the picture encoding.
float3 mk_displayTransform(float3 c, thread const mk_Inputs& in) {
  constant mk_PassParams& p = in.pass;
  if (MK_TRANSFORM == 1) {
    // MonitorKit display assist v1: scene light, Rec.709, the BT.709 OETF with a
    // shoulder. One log2 and one exp2 per channel serve both branches: the OETF's
    // x^0.45 and the shoulder's (x / xk)^-q.
    float3 x = mk_rows(p.transformMatrix, mk_logDecodeFast(mk_logSignalFast(c, MK_LOG_CURVE, in.frame), MK_LOG_CURVE));
    bool3 over = x > p.assist.x;
    float3 lx = fast::log2(max(x, .018f));
    float3 t = fast::exp2(select(.45f * lx, -p.assist.z * (lx - p.assist.w), over));
    float3 oetf = select(1.099f * t - .099f, 4.5f * max(x, 0.0f), x < .018f);
    return select(oetf, p.assist.y + (1 - p.assist.y) * (1 - t), over);
  }
  if (MK_TRANSFORM == 2) {
    // PQ by display light: the EETF to graphics white, Rec.709, BT.1886.
    float3 e = saturate(c);
    float3 l = mk_rows(p.transformMatrix, mk_toneMapPQ(mk_pqNits3(e), max3(e.r, e.g, e.b), p.toneMap) * p.colorLevels.y);
    return mk_powf(saturate(l), float3(1 / 2.4f));
  }
  if (MK_TRANSFORM == 3) {
    // HLG by scene light: 75% HLG is 100% SDR, Rec.709, the BT.709 OETF.
    return mk_bt709OETF(min(mk_rows(p.transformMatrix, mk_hlgInverseOETF3(c) * p.hlgSource.z), 1.0f));
  }
  return c;
}

// Linear display light, 1 = graphics white, from transfer `tf`.
float3 mk_toLinear(float3 v, uint tf, constant mk_PassParams& p) {
  if (tf == 2) {
    float3 a = abs(v);
    return sign(v) * select(mk_powf((a + .055f) * (1 / 1.055f), float3(2.4f)), a * (1 / 12.92f), a <= .04045f);
  }
  if (tf == 3) return mk_mirrorPow(v, 2.2f);
  if (tf == 4) return v;
  if (tf == 5) return mk_pqNits3(v) * p.colorLevels.y;
  if (tf == 6) return mk_hlgOOTF(mk_hlgInverseOETF3(v), p.hlgSource.x, p.hlgSource.y, p.pictureWeights.rgb) * p.colorLevels.y;
  return mk_mirrorPow(v, 2.4f);
}

// Linear display light, 1 = graphics white, encoded with `tf` and clipped to what it
// holds. `w`: the luminance weights of its primaries (the HLG inverse OOTF).
float3 mk_fromLinear(float3 l, uint tf, float3 w, constant mk_PassParams& p) {
  if (tf == 2) {
    l = saturate(l);
    return select(1.055f * mk_powf(l, float3(1 / 2.4f)) - .055f, l * 12.92f, l <= .0031308f);
  }
  if (tf == 3) return mk_powf(saturate(l), float3(1 / 2.2f));
  if (tf == 4) return clamp(l, -65504.0f, 65504.0f);
  if (tf == 5) return mk_pqSignal(l * p.colorLevels.x);
  if (tf == 6) {
    float3 f = clamp(l * p.colorLevels.x, 0.0f, p.colorLevels.z);
    return mk_hlgOETF(mk_hlgInverseOOTF(f, p.colorLevels.z, p.colorLevels.w, w));
  }
  return mk_powf(saturate(l), float3(1 / 2.4f));
}

// A picture value (after adjustments) to the target value.
float3 mk_present(float3 v, constant mk_PassParams& p) {
  if (MK_TARGET_TF == 0) return v;
  float3 l = mk_rows(p.toTarget, mk_toLinear(v, MK_PICTURE_TF, p));
  if (MK_ROLLOFF) l = mk_toneMap(l * p.colorLevels.x, p.toneMap) * p.colorLevels.y;
  return mk_fromLinear(l, MK_TARGET_TF, p.targetWeights.rgb, p);
}

// ---------------------------------------------------------------- false colour

// First band containing `value` (lower inclusive, upper exclusive), else `fallback`:
// a grey in the monitor stage's encoding, so it goes through the display transform
// and the output conversion like the picture. Both come out in target values.
float3 mk_bands(float value, float3 fallback, thread const mk_Inputs& in) {
  constant mk_PassParams& p = in.pass;
  // Scanned from the last band without an early exit, so the tests do not wait on each other.
  int band = -1;
  for (int i = int(p.modes.z) - 1; i >= 0; i--)
    if (value >= p.bandEdges[i].x && value < p.bandEdges[i].y) band = i;
  return band >= 0 ? p.bandColors[band].rgb : mk_present(mk_displayTransform(fallback, in), p);
}

// Log modes classify the source pixel under the display pixel's centre, never a
// filtered or LUT value. `centre` is that pixel's decode (R'G'B', Y').
float3 mk_logFalseColor(float4 centre, thread const mk_Inputs& in) {
  constant mk_PassParams& p = in.pass;
  constant mk_FrameParams& f = in.frame;
  uint measure = p.modes.x;
  float3 native = mk_nativeLog(centre.rgb, f);
  // Unbanded pixels are native-signal grey, or with the log transform on, the
  // transform of the decoded grey, as the picture is shown.
  bool transformed = MK_TRANSFORM != 0;
  float3 decodedGrey = float3(saturate(mk_luma709(centre.rgb)));
  if (measure == MK_FC_SONY) {
    // Sony Pattern 2 on native signal luma, in native IRE: (code - 64) / 876.
    float signal = mk_nativeLog(centre.w, f);
    return mk_bands((signal * 1023 - 64) / 876 * 100, transformed ? float3(saturate(centre.w)) : float3(signal), in);
  }
  if (measure == MK_FC_ARRI_LOGC) {
    // The 10-bit transport code, classified in the table of the declared range.
    // Full-range camera codes rescaled into legal classify as native full-range
    // codes; in a full container they are first read as the container's own codes.
    float a = mk_luma709(centre.rgb);
    float code = f.options.y ? a * (f.options.z ? f.levels.y : 1023) : a * 876 + 64;
    // Neutral integral 10-bit samples restore their exact transport code after
    // float normalization, before any rescale, so table edges stay exact.
    if (p.modes.w != 0 && centre.r == centre.g && centre.g == centre.b) code = round(code);
    if (f.options.z) code = (f.options.y ? mk_unsqueezeLegal(float3(code), f).x : (code - 64) / 876) * 1023;
    return mk_bands(code, transformed ? decodedGrey : float3(mk_luma709(p.falseColor.y != 0 ? native : centre.rgb)), in);
  }
  float y = dot(mk_logDecode(native, 1), p.gamutWeights.rgb);
  float3 nativeGrey = transformed ? decodedGrey : float3(mk_luma709(native));
  if (measure == MK_FC_ARRI_STYLE) return mk_bands(mk_logC3ReferenceCode(y), nativeGrey, in);
  // EL Zone: stops over 18% grey of source-gamut scene-linear Y, plus the user offset.
  if (y <= 0) return float3(0);
  return mk_bands(log2(y) - log2(.18f) + p.falseColor.x, nativeGrey, in);
}

// Display-referred modes measure the stage of the filtered display pixel.
float3 mk_stageFalseColor(thread const mk_Stages& s, thread const mk_Inputs& in) {
  constant mk_PassParams& p = in.pass;
  uint stage = p.modes.y;
  float3 fallback = float3(clamp(mk_luma709(mk_stage(s, stage)), 0.0f, 1.0f));
  if (p.modes.x == MK_FC_STAGE_IRE) return mk_bands(mk_stageLuma(s, stage, p) * 100, fallback, in);
  // Stops over 18% grey. A LUT result is Rec.709 display R'G'B'; an untouched
  // source is linearized by its own curve: the log decode in source-gamut Y, else
  // its display transfer, each channel, weighted by its Y'CbCr matrix.
  float linear;
  if (mk_stageIsLUT(stage, p)) {
    float3 c = stage == 2 && p.luts.y != 0 ? s.monitor : s.output;
    linear = mk_luma709(float3(mk_bt709Linear(c.r), mk_bt709Linear(c.g), mk_bt709Linear(c.b)));
  } else if (p.luts.z != 0) {
    linear = dot(mk_logDecode(mk_logSignal(s.source, p.luts.z, in.frame), p.luts.z), p.gamutWeights.rgb);
  } else {
    uint t = p.luts.w;
    float3 c = float3(mk_exposureLinear(s.source.r, t), mk_exposureLinear(s.source.g, t), mk_exposureLinear(s.source.b, t));
    linear = mk_luma(c, in.frame.matrix.xyz);
  }
  float stops = linear > 0 ? log2(linear) - log2(.18f) + p.falseColor.x : -INFINITY;
  return mk_bands(stops, fallback, in);
}

// ---------------------------------------------------------------- overlays

// Max focus confidence over the picture footprint of the display pixel whose
// corner is `corner` (an integer). Up to 8 × 8 texels the footprint is covered by
// 2 × 2 gathers, overlapping at odd extents (max is idempotent): a 3 × 3 or 4 × 4
// footprint costs four gathers instead of 9 or 16 reads, a 2 × 2 one a single
// gather. A footprint one texel wide on an axis is read texel by texel; larger
// than 8 is subsampled 8 × 8.
inline float mk_gatherMax(texture2d<float, access::sample> mask, float2 corner) {
  // Pixel coordinates: a gather at texel corner p returns texels p - 1 … p.
  constexpr sampler s(coord::pixel, address::clamp_to_edge, filter::nearest);
  float4 g = mask.gather(s, corner);
  return max(max(g.x, g.y), max(g.z, g.w));
}

float mk_focusFootprint(texture2d<float, access::sample> mask, float2 corner, float4 map) {
  float2 a = corner * map.xy + map.zw, b = (corner + 1) * map.xy + map.zw;
  float2 low = min(a, b), high = max(a, b);
  float2 base = floor(low), extent = ceil(high) - base;
  float2 size = float2(mask.get_width(), mask.get_height()), limit = size - 1;
  if (all(extent <= 1)) return mask.read(uint2(clamp(base, float2(0), limit))).r;
  if (all(extent <= 8) && all(extent >= 2)) {
    // Offsets end flush with the footprint; up to 4 × 4 that is the first and the last pair.
    float2 last = max(extent - 2, float2(0)), first = base + 1;
    if (all(extent == 2)) return mk_gatherMax(mask, first);
    if (all(extent <= 4)) {
      return max(max(mk_gatherMax(mask, first), mk_gatherMax(mask, first + float2(last.x, 0))),
                 max(mk_gatherMax(mask, first + float2(0, last.y)), mk_gatherMax(mask, first + last)));
    }
    uint2 count = uint2(ceil(extent * .5f));
    float confidence = 0;
    for (uint y = 0; y < count.y; y++)
      for (uint x = 0; x < count.x; x++) confidence = max(confidence, mk_gatherMax(mask, first + min(float2(x, y) * 2, last)));
    return confidence;
  }
  uint2 count = uint2(clamp(extent, float2(1), float2(8)));
  bool subsampled = any(extent > 8);
  float confidence = 0;
  for (uint y = 0; y < count.y; y++)
    for (uint x = 0; x < count.x; x++) {
      float2 pos = subsampled ? floor(low + (float2(x, y) + .5f) / float2(count) * (high - low)) : base + float2(x, y);
      confidence = max(confidence, mask.read(uint2(clamp(pos, float2(0), limit))).r);
    }
  return confidence;
}

// Coverage of one stroke at pixel centre p: (line, outline). Butt ends: coverage
// across times coverage along, so strokes end exactly at their endpoints and
// snapped strokes stay pixel-crisp. `across` and `inside` are distances in pixels.
inline float2 mk_strokeCoverage(float across, float inside, float hw, float o) {
  return float2(clamp(hw + .5f - across, 0.0f, 1.0f) * clamp(inside + .5f, 0.0f, 1.0f),
                clamp(hw + o + .5f - across, 0.0f, 1.0f) * clamp(inside + o + .5f, 0.0f, 1.0f));
}

// Axis-aligned strokes lines[begin..<end], sorted by position along `axis`: the
// first within reach by binary search, then the few after it.
float2 mk_axisStrokes(float2 p, uint begin, uint end, uint axis, constant mk_Guides& g) {
  float reach = g.reach.x, o = g.reach.y, v = p[axis], w = p[1 - axis];
  uint lo = begin, hi = end;
  while (lo < hi) {
    uint mid = (lo + hi) / 2;
    if (g.lines[mid].x < v - reach) lo = mid + 1; else hi = mid;
  }
  float2 cover = 0;
  for (uint i = lo; i < end && g.lines[i].x <= v + reach; i++) {
    float4 l = g.lines[i];
    cover = max(cover, mk_strokeCoverage(abs(v - l.x), min(w - l.y, l.z - w), l.w, o));
  }
  return cover;
}

float2 mk_guideCoverage(float2 p, constant mk_Guides& g) {
  uint nv = g.counts.x, nh = g.counts.y;
  float2 cover = 0;
  if (mk_guideCell(p.x, 0, g)) cover = mk_axisStrokes(p, 0, nv, 0, g);
  if (mk_guideCell(p.y, 1, g)) cover = max(cover, mk_axisStrokes(p, nv, nv + nh, 1, g));
  float o = g.reach.y;
  for (uint i = 0; i < g.counts.z; i++) {
    float4 e = g.others[2 * i];
    float hw = g.others[2 * i + 1].x;
    float2 a = e.xy, ab = e.zw - a;
    float length2 = dot(ab, ab);
    if (length2 == 0) {
      // A dot: round, with a one-pixel antialiased edge.
      float dist = length(p - a);
      cover = max(cover, float2(clamp(hw + .5f - dist, 0.0f, 1.0f), clamp(hw + o + .5f - dist, 0.0f, 1.0f)));
      continue;
    }
    float len = sqrt(length2);
    float2 u = ab / len, q = p - a;
    float along = dot(q, u);
    cover = max(cover, mk_strokeCoverage(abs(q.x * u.y - q.y * u.x), min(along, len - along), hw, o));
  }
  return cover;
}

// The white-point trim (MonitorColorPipeline.whiteTrimmed): gains in linear light,
// back into the picture's transfer `tf`, unclipped. On a power-law picture that is
// a gain on the signal itself.
float3 mk_whiteTrim(float3 c, uint tf, constant mk_PassParams& p) {
  if (tf == 1 || tf == 3 || tf == 4) return c * p.whiteSignalGain.rgb;
  float3 l = mk_toLinear(c, tf, p) * p.whiteGain.rgb;
  if (tf == 2) {
    float3 a = abs(l);
    return sign(l) * select(1.055f * mk_powf(a, float3(1 / 2.4f)) - .055f, a * 12.92f, a <= .0031308f);
  }
  return mk_fromLinear(l, tf, p.pictureWeights.rgb, p);
}

float3 mk_adjust(float3 c, constant mk_PassParams& p) {
  if (!MK_ADJUST || p.flags.y) return c;
  if (p.display.w == 1) c = float3(mk_luma709(c));
  else if (p.display.w == 2) c = float3(c.b);
  float y = mk_luma709(c);
  c = y + (c - y) * p.display.z;
  c = (c - .5f) * p.display.y + .5f + p.display.x;
  // Last, as a display's white balance acts on its drives after the picture controls.
  uint tf = uint(p.whiteGain.w);
  return tf != 0 ? mk_whiteTrim(c, tf, p) : c;
}

// v mod m in 0…m - 1 for |v| < 2^23, m > 0, from a float quotient (the
// integer remainder by a run-time divisor is a long sequence on the GPU): its
// rounding is under one, so one correction step makes it exact.
inline int mk_modulo(int v, int m, float inverse) {
  int r = v - int(floor(float(v) * inverse)) * m;
  return r < 0 ? r + m : (r >= m ? r - m : r);
}

bool mk_inside(float2 d, float4 r) { return r.x < r.z && all(d >= r.xy) && all(d < r.zw); }

struct mk_VertexOut { float4 position [[position]]; };

// One triangle covering the viewport.
vertex mk_VertexOut mk_fullscreen(uint id [[vertex_id]]) {
  float2 uv = float2((id << 1) & 2, id & 2);
  mk_VertexOut out;
  out.position = float4(uv * float2(2, -2) + float2(-1, 1), 0, 1);
  return out;
}

// The picture at target pixel centre `position` (i + .5). The fragment and the
// compute entry points share it, so both write the same values.
inline __attribute__((always_inline))
float4 mk_pictureAt(float2 position, thread const mk_Inputs& in, texture2d<float, access::sample> focusMask,
                    constant mk_Guides& guides) {
  constant mk_PassParams& p = in.pass;
  float2 d = position - p.viewport.xy;  // viewport pixel centre (i + .5)
  float2 corner = floor(d);
  float3 c = float3(0);

  bool navigator = MK_NAVIGATOR && mk_inside(d, p.navigatorRect);
  if (!navigator && !mk_inside(d, p.imageRect)) return float4(0, 0, 0, 1);
  // Clean surfaces have every tool off in `p` already.
  uint measure = p.modes.x;
  bool logFalseColor = (MK_FALSE_COLOR & 1) != 0 && measure >= MK_FC_SONY && measure <= MK_FC_ELZONE;
  bool stageFalseColor = (MK_FALSE_COLOR & 2) != 0 && measure >= MK_FC_STAGE_IRE;
  // A log false-colour picture classifies the source pixel under the display
  // pixel's centre, so the image is point-sampled while it is shown.
  float4 map = navigator ? p.navigatorToPicture : p.displayToPicture;
  float4 sample = mk_filtered(d, map, !navigator && (p.flags.x != 0 || logFalseColor), navigator ? 2 : 8, in);
  mk_Stages s = mk_stages(sample, in);

  if (navigator) {
    // The whole picture, dimmed (never above graphics white), with the visible region outlined.
    c = clamp(mk_present(mk_adjust(mk_displayTransform(mk_stage(s, MK_PICTURE_STAGE), in), p), p), 0.0f,
              p.overlayWhite.rgb) * .85f;
    float4 n = p.navigatorRect, r = p.navigatorVisible;
    if (any(d < n.xy + 1) || any(d >= n.zw - 1)) c = p.navigatorColors[0].rgb;
    bool box = all(d >= r.xy - 1) && all(d < r.zw + 1);
    if (box && (any(d < r.xy + 1) || any(d >= r.zw - 1))) c = p.navigatorColors[1].rgb;
  } else {
    if (logFalseColor) c = mk_logFalseColor(sample, in);
    else if (stageFalseColor) c = mk_stageFalseColor(s, in);
    else c = mk_present(mk_adjust(mk_displayTransform(mk_stage(s, MK_PICTURE_STAGE), in), p), p);
    // Overlays mix in target values with colours encoded for the target.
    {
      int2 px = int2(corner);
      if (MK_ZEBRAS && p.zebra.z != 0) {
        int period = int(p.zebra.w), stripe = period / 2;
        float inverse = p.reciprocals.w != 0 ? p.reciprocals.w : 1.0f / float(period);
        if (p.zebra.z & 1) {
          float ire = mk_stageLuma(s, p.zebra.x, p) * 100;
          if (ire >= p.zebra0.x && ire < p.zebra0.y && mk_modulo(px.x + px.y, period, inverse) < stripe)
            c = mix(c, p.zebraColors[0].rgb, p.zebra0.z);
        }
        if (p.zebra.z & 2) {
          // The second set slants the other way, so both read at once.
          float ire = mk_stageLuma(s, p.zebra.y, p) * 100;
          if (ire >= p.zebra1.x && ire < p.zebra1.y && mk_modulo(px.x - px.y, period, inverse) < stripe)
            c = mix(c, p.zebraColors[1].rgb, p.zebra1.z);
        }
      }
      if (MK_CLIP && p.colorFlags.y != 0) {
        // Each enabled channel at or above the over level (or else at or below the
        // under level) sets its bit; the bits pick the colour. Over wins.
        uint stage = p.colorFlags.w, mask = p.colorFlags.z;
        float3 v = mk_stage(s, stage) * 100;
        float y = mk_stageLuma(s, stage, p) * 100;
        uint3 bits = uint3(1, 2, 4) & uint3(mask);
        uint3 o = select(uint3(0), bits, v >= p.clipLevels.x), u = select(uint3(0), bits, v <= p.clipLevels.y);
        uint over = o.x | o.y | o.z, under = u.x | u.y | u.z;
        bool luma = (mask & 8) != 0;
        if (over != 0 || (luma && y >= p.clipLevels.x)) c = mix(c, p.clipColors[over].rgb, p.clipLevels.z);
        else if (under != 0 || (luma && y <= p.clipLevels.y)) c = mix(c, p.clipColors[8 + under].rgb, p.clipLevels.z);
      }
      if (MK_PEAKING && p.focus.z != 0) {
        float k = p.focus.x * mk_focusFootprint(focusMask, corner, map);
        c = p.focus.y == 0 ? mix(c, p.focusColor.rgb, k) : c + (p.overlayWhite.rgb - c) * k;
      }
      if (MK_GUIDES && p.guide.z != 0) {
        if (mk_inside(d, p.guideRect) && !mk_inside(d, p.matte) && p.matte.x < p.matte.z) c *= 1 - p.guide.w;
        if (p.guideColor.w != 0) {
          float2 g = mk_guideCoverage(d, guides);
          c = mix(c, float3(0), g.y * p.guide.y);
          c = mix(c, p.guideColor.rgb, g.x * p.guide.x);
        }
      }
    }
  }
  // Extended linear keeps out-of-gamut and above-white values, as does a linear
  // picture written as it is (its layer is extended linear); everything else is 0…1.
  bool extended = MK_TARGET_TF == 4 || (MK_TARGET_TF == 0 && MK_PICTURE_TF == 4);
  c = extended ? clamp(c, -65504.0f, 65504.0f) : clamp(c, 0.0f, 1.0f);
  if (MK_SRGB_TARGET) c = mk_srgbDecode(c);
  return float4(c, 1);
}

fragment float4 mk_picture(mk_VertexOut v [[stage_in]],
                           texture2d<uint, access::read> packed [[texture(0)]],
                           texture2d<float, access::read> luma [[texture(1)]],
                           texture2d<float, access::read> chroma [[texture(2)]],
                           texture3d<float, access::sample> burnLUT [[texture(3)]],
                           texture3d<float, access::sample> monitorLUT [[texture(4)]],
                           texture2d<float, access::sample> focusMask [[texture(5)]],
                           constant mk_FrameParams& frame [[buffer(0)]],
                           constant mk_LUTParams& burn [[buffer(1)]],
                           constant mk_LUTParams& monitor [[buffer(2)]],
                           constant mk_PassParams& p [[buffer(3)]],
                           constant mk_Guides& guides [[buffer(4)]]) {
  mk_Inputs in = {packed, luma, chroma, burnLUT, monitorLUT, frame, burn, monitor, p};
  return mk_pictureAt(v.position.xy, in, focusMask, guides);
}

// The same picture written by a compute kernel into the viewport of a
// shader-writable target (never *_srgb: MK_SRGB_TARGET is off), one thread per
// viewport pixel.
kernel void mk_pictureKernel(texture2d<uint, access::read> packed [[texture(0)]],
                             texture2d<float, access::read> luma [[texture(1)]],
                             texture2d<float, access::read> chroma [[texture(2)]],
                             texture3d<float, access::sample> burnLUT [[texture(3)]],
                             texture3d<float, access::sample> monitorLUT [[texture(4)]],
                             texture2d<float, access::sample> focusMask [[texture(5)]],
                             texture2d<float, access::write> target [[texture(6)]],
                             constant mk_FrameParams& frame [[buffer(0)]],
                             constant mk_LUTParams& burn [[buffer(1)]],
                             constant mk_LUTParams& monitor [[buffer(2)]],
                             constant mk_PassParams& p [[buffer(3)]],
                             constant mk_Guides& guides [[buffer(4)]],
                             uint2 xy [[thread_position_in_grid]]) {
  if (xy.x >= uint(p.viewport.z) || xy.y >= uint(p.viewport.w)) return;
  mk_Inputs in = {packed, luma, chroma, burnLUT, monitorLUT, frame, burn, monitor, p};
  uint2 pixel = xy + uint2(p.viewport.xy);
  target.write(mk_pictureAt(float2(pixel) + .5f, in, focusMask, guides), pixel);
}

// ---------------------------------------------------------------- freeze

// Freeze copies a frame's planes texel for texel into owned textures (a compute
// pass: the library encodes no blits). Unorm and float values round-trip exactly.
kernel void mk_copyUint(texture2d<uint, access::read> source [[texture(0)]],
                        texture2d<uint, access::write> copy [[texture(1)]],
                        uint2 xy [[thread_position_in_grid]]) {
  if (xy.x >= copy.get_width() || xy.y >= copy.get_height()) return;
  copy.write(source.read(xy), xy);
}

kernel void mk_copyFloat(texture2d<float, access::read> source [[texture(0)]],
                         texture2d<float, access::write> copy [[texture(1)]],
                         uint2 xy [[thread_position_in_grid]]) {
  if (xy.x >= copy.get_width() || xy.y >= copy.get_height()) return;
  copy.write(source.read(xy), xy);
}

// ---------------------------------------------------------------- analysis

// Left-sited v210 R'G'B' of pixel xy for the analysis: mk_decode's values, with
// the picture pass's select-picked lanes and exact quotients by the reciprocals
// in `inverse` (x luma span, y chroma span, z kg). An odd pixel's next chroma
// sample is pixel x + 1's co-sited one, which the next SIMD lane decodes, so only
// a row's last lane reads it itself (a row of lanes is one SIMD-group, and every
// lane calls this).
float3 mk_focusV210RGB(texture2d<uint, access::read> packed, uint2 xy, bool lastLane, constant mk_FrameParams& f,
                       float3 inverse) {
  uint4 g = packed.read(uint2(xy.x / 6, xy.y));
  uint n = xy.x % 6;
  float2 c = mk_v210ChromaLane(g, n / 2);
  float2 after = simd_shuffle_down(c, 1);
  if (n & 1) {
    if (lastLane) after = mk_v210NextLane(packed, g, n / 2, xy, f);
    else if (mk_v210LastPair(xy.x, f)) after = c;
    c = mix(c, after, .5f);
  }
  float y = mk_quotient(mk_v210LumaLane(g, n) - f.levels.x, f.levels.y, inverse.x);
  return mk_ycbcrToRGB(y, mk_quotient(c - f.levels.z, f.levels.w, inverse.y), f.matrix, inverse.z);
}

// Y' an edge is measured on: the transport luma, or with MK_LUTS the Rec.709 luma
// after the LUTs its bits select (1 burn-in, 2 monitor; a disabled LUT passes through).
// mk_decodeLuma's and mk_decodeRGB's values, with exact quotients (RGB as MKDecode).
float mk_focusLuma(texture2d<uint, access::read> packed, texture2d<float, access::read> luma,
                   texture2d<float, access::read> chroma, texture3d<float, access::sample> burnLUT,
                   texture3d<float, access::sample> monitorLUT, uint2 xy, bool lastLane, constant mk_FrameParams& f,
                   constant mk_LUTParams& burn, constant mk_LUTParams& monitor, float3 inverse) {
  if (MK_LUTS == 0) {
    if (MK_LAYOUT(f) == MK_RGB) return mk_decode(packed, luma, chroma, xy, f).w;
    return mk_quotient(mk_lumaCode(packed, luma, xy, f) - f.levels.x, f.levels.y, inverse.x);
  }
  float3 c;
  if (MK_LAYOUT(f) == MK_V210 && !f.options.x) {
    c = mk_focusV210RGB(packed, xy, lastLane, f, inverse);
  } else if (MK_LAYOUT(f) == MK_RGB) {
    c = mk_decodeRGB(packed, luma, chroma, xy, f);
  } else {
    float y = mk_quotient(mk_lumaCode(packed, luma, xy, f) - f.levels.x, f.levels.y, inverse.x);
    c = mk_ycbcrToRGB(y, mk_quotient(mk_chromaCode(packed, chroma, xy, f) - f.levels.z, f.levels.w, inverse.y),
                      f.matrix, inverse.z);
  }
  if (MK_LUTS & 1) c = mk_applyLUT(c, burnLUT, burn);
  if (MK_LUTS & 2) c = mk_applyLUT(c, monitorLUT, monitor);
  return mk_luma709(c);
}

// Edge confidence from a pixel's eight neighbours' lumas: Sobel-like 3-10-3
// gradients, kept only where a directional median exceeds the noise level.
// The ramp is clamp(excess / span, 0, 1), span = max(.0001, threshold / 2): a
// quotient is taken only strictly inside it, exactly, from `inverseSpan` = 1 / span
// (at or past the ends, and for non-finite lumas, the clamp decides alone).
inline float mk_focusConfidence(float tl, float tc, float tr, float ml, float mr, float bl, float bc, float br,
                                float2 thresholds, float inverseSpan) {
  float3 dx = float3(tr - tl, mr - ml, br - bl), dy = float3(bl - tl, bc - tc, br - tr);
  float gx = dot(dx, float3(3, 10, 3)) / 16, gy = dot(dy, float3(3, 10, 3)) / 16;
  float support = max(abs(max(min(dx.x, dx.y), min(max(dx.x, dx.y), dx.z))), abs(max(min(dy.x, dy.y), min(max(dy.x, dy.y), dy.z))));
  float threshold = thresholds.x, noise = thresholds.y, span = max(.0001f, threshold * .5f);
  float excess = max(abs(gx), abs(gy)) - threshold;
  float ramp = excess >= span ? 1.0f : (excess > 0 ? mk_quotient(excess, span, inverseSpan) : 0.0f);
  return support > noise ? ramp : 0;
}

// Rows of the mask per thread (MonitorFeed.focusRows).
constant uint MK_FOCUS_ROWS = 16;

// Source-resolution edge confidence, shared by every surface of a feed. A thread
// takes one column of MK_FOCUS_ROWS pixels and walks down it, decoding each row
// once (the rows above and below the run included) and keeping three rows of
// lumas; its left and right neighbours' come from the adjacent SIMD lanes. Each
// row of the threadgroup is one SIMD-group whose two outer lanes only supply halo,
// so no threadgroup memory or barrier is needed and each pixel is decoded about
// 1.2 times (18/16 down, 32/30 across; the 8-row form decoded 1.33, the 16 × 16
// tile before it took twice as long). The quotients by the frame's spans and the
// threshold use reciprocals computed once per thread. Positions clamp to the
// picture, so tail groups are correct.
kernel void mk_focusMask(texture2d<uint, access::read> packed [[texture(0)]],
                         texture2d<float, access::read> luma [[texture(1)]],
                         texture2d<float, access::read> chroma [[texture(2)]],
                         texture2d<float, access::write> mask [[texture(3)]],
                         texture3d<float, access::sample> burnLUT [[texture(4)]],
                         texture3d<float, access::sample> monitorLUT [[texture(5)]],
                         constant mk_FrameParams& f [[buffer(0)]],
                         constant float2& thresholds [[buffer(1)]],
                         constant mk_LUTParams& burn [[buffer(2)]],
                         constant mk_LUTParams& monitor [[buffer(3)]],
                         uint2 group [[threadgroup_position_in_grid]],
                         uint2 local [[thread_position_in_threadgroup]],
                         uint2 groupSize [[threads_per_threadgroup]]) {
  uint w = f.shape.y, h = f.shape.z;
  int x = int(group.x * (groupSize.x - 2) + local.x) - 1;
  uint y0 = (group.y * groupSize.y + local.y) * MK_FOCUS_ROWS;
  uint cx = uint(clamp(x, 0, int(w) - 1));
  bool lastLane = local.x == groupSize.x - 1, writes = local.x != 0 && !lastLane && x < int(w);
  float3 inverse = float3(1.0f / f.levels.y, 1.0f / f.levels.w, 1.0f / f.matrix.y);
  float inverseSpan = 1.0f / max(.0001f, thresholds.x * .5f);
  // Rows y0 - 1 … y0 + MK_FOCUS_ROWS, stopping after the picture's last row (one
  // past it, clamped, closes the last mask row). Uniform per SIMD-group, so every
  // lane shuffles, halo and out-of-picture ones included.
  uint rows = uint(clamp(int(h) + 2 - int(y0), 0, int(MK_FOCUS_ROWS) + 2));
  float above = 0, aboveLeft = 0, aboveRight = 0, centre = 0, left = 0, right = 0;
  for (uint j = 0; j < rows; j++) {
    uint2 p = uint2(cx, uint(clamp(int(y0 + j) - 1, 0, int(h) - 1)));
    float below = mk_focusLuma(packed, luma, chroma, burnLUT, monitorLUT, p, lastLane, f, burn, monitor, inverse);
    float belowLeft = simd_shuffle_up(below, 1), belowRight = simd_shuffle_down(below, 1);
    if (j >= 2 && writes) {
      float c = mk_focusConfidence(aboveLeft, above, aboveRight, left, right, belowLeft, below, belowRight, thresholds,
                                   inverseSpan);
      mask.write(float4(c), uint2(x, y0 + j - 2));
    }
    above = centre;
    aboveLeft = left;
    aboveRight = right;
    centre = below;
    left = belowLeft;
    right = belowRight;
  }
}
