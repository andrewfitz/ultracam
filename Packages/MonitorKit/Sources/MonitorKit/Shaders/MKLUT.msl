// MonitorKit 3D LUT sampling. Self-contained: a host can prepend this file to
// its own Metal source and call mk_applyLUT in its own kernel, so a burned-in
// LUT adds no pass. Every symbol is prefixed mk_.
#include <metal_stdlib>
using namespace metal;

#ifndef MK_LUT_MSL
#define MK_LUT_MSL

// Mirrors MonitorKit.LUTParameters.
struct mk_LUTParams {
  float4 domainLow;    // xyz: 3D DOMAIN_MIN
  float4 domainScale;  // xyz: 1 / (DOMAIN_MAX - DOMAIN_MIN)
  uint4 shape;         // x: lattice size, y: interpolation (0 tetrahedral, 1 trilinear, 2 hardware), z: enabled, w: 1D shaper entries (0 none)
  float4 shaperLow;    // xyz: shaper input minimum; w: 1 when there is no 3D table
  float4 shaperScale;  // xyz: 1 / (shaper input maximum - minimum)
};

// Lattice is an rgba32Float texture3d; x is red, y green, z blue. Its first n
// slices hold the lattice (in their n × n corner); a 1D shaper follows in rows
// of the texture's width w (at least 8, so a small lattice holds a 65536-entry
// shaper): entry i at (i % w, i / w % w, n + i / w²).
inline float3 mk_lattice(texture3d<float, access::sample> lut, uint3 i) { return lut.read(i).rgb; }

inline float3 mk_shaperEntry(texture3d<float, access::sample> lut, uint i, uint n, uint w) {
  return lut.read(uint3(i % w, i / w % w, n + i / (w * w))).rgb;
}

// The 1D table per channel, linear between entries (CubeLUT.applyShaper).
float3 mk_shaper(float3 rgb, texture3d<float, access::sample> lut, mk_LUTParams p) {
  uint m = p.shape.w, n = p.shape.x, w = lut.get_width();
  float3 position = clamp((rgb - p.shaperLow.xyz) * p.shaperScale.xyz, 0.0f, 1.0f) * float(m - 1);
  uint3 lo = uint3(floor(position)), hi = min(lo + 1, uint3(m - 1));
  float3 t = position - float3(lo);
  float3 out;
  for (uint c = 0; c < 3; c++) out[c] = mix(mk_shaperEntry(lut, lo[c], n, w)[c], mk_shaperEntry(lut, hi[c], n, w)[c], t[c]);
  return out;
}

float3 mk_applyLUT(float3 rgb, texture3d<float, access::sample> lut, mk_LUTParams p) {
  if (p.shape.z == 0) return rgb;
  if (p.shape.w != 0) {
    rgb = mk_shaper(rgb, lut, p);
    if (p.shaperLow.w != 0) return rgb;
  }
  uint n = p.shape.x;
  float3 position = clamp((rgb - p.domainLow.xyz) * p.domainScale.xyz, 0.0f, 1.0f) * float(n - 1);
  if (p.shape.y == 2) {
    // Normalized per axis by the texture's size: a shaper's slices sit beyond
    // the lattice in z, and a small lattice in the corner of wider slices.
    constexpr sampler filtered(coord::normalized, address::clamp_to_edge, filter::linear);
    return lut.sample(filtered, (position + 0.5f) / float3(lut.get_width(), lut.get_height(), lut.get_depth())).rgb;
  }
  uint3 lo = uint3(floor(position)), hi = min(lo + 1, uint3(n - 1));
  float3 t = position - float3(lo);
  if (p.shape.y == 1) {
    // The original Ultracam order: x, then y, then z.
    float3 a = mix(mk_lattice(lut, uint3(lo.x, lo.y, lo.z)), mk_lattice(lut, uint3(hi.x, lo.y, lo.z)), t.x);
    float3 b = mix(mk_lattice(lut, uint3(lo.x, hi.y, lo.z)), mk_lattice(lut, uint3(hi.x, hi.y, lo.z)), t.x);
    float3 c = mix(mk_lattice(lut, uint3(lo.x, lo.y, hi.z)), mk_lattice(lut, uint3(hi.x, lo.y, hi.z)), t.x);
    float3 d = mix(mk_lattice(lut, uint3(lo.x, hi.y, hi.z)), mk_lattice(lut, uint3(hi.x, hi.y, hi.z)), t.x);
    return mix(mix(a, b, t.y), mix(c, d, t.y), t.z);
  }
  // Tetrahedral, branch-free: the six tetrahedra differ only in which axes come
  // first and second in descending t, and neighbouring pixels pick different ones,
  // so branches would diverge. The weights and summation order are those of each
  // case of CubeLUT.apply: (1 - max) c000 + (max - mid) cA + (mid - min) cB + min c111.
  bool xy = t.x > t.y, yz = t.y > t.z, xz = t.x > t.z, zy = t.z > t.y, zx = t.z > t.x;
  uint3 X = uint3(1, 0, 0), Y = uint3(0, 1, 0), Z = uint3(0, 0, 1);
  uint3 first = xy ? (yz || xz ? X : Z) : (zy ? Z : Y);
  uint3 second = xy ? (yz ? Y : (xz ? Z : X)) : (zy ? Y : (zx ? Z : X));
  uint3 third = uint3(1) - first - second;
  float tMax = dot(t, float3(first)), tMid = dot(t, float3(second)), tMin = dot(t, float3(third));
  float3 cA = mk_lattice(lut, select(lo, hi, first != 0)), cB = mk_lattice(lut, select(lo, hi, (first + second) != 0));
  return (1 - tMax) * mk_lattice(lut, lo) + (tMax - tMid) * cA + (tMid - tMin) * cB + tMin * mk_lattice(lut, hi);
}

#endif
