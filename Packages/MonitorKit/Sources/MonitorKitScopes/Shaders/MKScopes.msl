// MonitorKit scopes. Compiled after MKLUT.msl and MKDecode.msl.
//
// Accumulation reads every source pixel once, decodes it with mk_decode (its
// exact-quotient form: the reciprocals once per thread, the same values),
// applies the stage's LUTs and adds it to threadgroup-private bins that are
// merged into persistent device bins. Every count is an integer, so results
// are identical however the GPU schedules the work.
#include <metal_stdlib>
using namespace metal;

// Mirrors MonitorKitScopes.ScopeKernelParameters. 16-byte rows.
struct mk_ScopeParams {
  uint4 shape;    // x: kind (0 waveform, 1 vectorscope, 2 histogram), y: mode, z: stage (0 source, 1 output, 2 monitor), w: channels
  uint4 bins;     // x: columns per channel | histogram bins | vectorscope side, y: waveform levels, z: device bins packed 16-bit, w: statistics slot (words)
  uint4 tile;     // x: waveform scope columns | histogram tile width, y: rows per threadgroup, z: pixels per run (histogram, vectorscope), w: bin words
  uint4 luts;     // x: burn-in LUT on, y: monitor LUT on, z: generation
  float4 level;   // x: axis low, y: bins per unit level, z: 1 / frame width
  float4 weights; // xyz: luma weights, w: 1 to use the decoded transport luma (no LUT, frame matrix)
  float4 chroma;  // x: 1 / (2 (1 - kb)), y: 1 / (2 (1 - kr)), z: vectorscope bins per unit chroma, w: half side
  float4 clip;    // x: high, y: low threshold in percent, both inclusive, compared as the picture's clip indicators do
};

constant uint MK_SCOPE_WAVEFORM = 0, MK_SCOPE_VECTOR = 1, MK_SCOPE_HISTOGRAM = 2;

// Statistics slot, in 32-bit words. Mirrors ScopeStatisticsWord.
constant uint MK_ST_BEGIN = 0, MK_ST_COUNT = 1, MK_ST_MIN = 2, MK_ST_MAX = 3, MK_ST_SUM_LO = 4,
              MK_ST_SUM_HI = 5, MK_ST_HIGH = 6, MK_ST_LOW = 10, MK_ST_PEAK = 14, MK_ST_END = 17,
              MK_ST_PEAK_ALL = 18, MK_ST_CHECK = 19, MK_ST_WORDS = 32;

// The slot's checksum (MonitorKitScopes.ScopeStatisticsWord.checksum): words
// BEGIN…PEAK_ALL but END, FNV-1a by word with a final avalanche. The GPU's
// stores need not reach the host in program order, so a host copy that caught
// the stamps of one accumulation and a word of another fails it.
inline uint mk_statsChecksum(device atomic_uint* slot) {
  uint h = 2166136261u;
  for (uint i = MK_ST_BEGIN; i <= MK_ST_PEAK_ALL; i++)
    if (i != MK_ST_END) h = (h ^ atomic_load_explicit(&slot[i], memory_order_relaxed)) * 16777619u;
  h ^= h >> 16;
  h *= 0x85EBCA6Bu;
  h ^= h >> 13;
  h *= 0xC2B2AE35u;
  return h ^ (h >> 16);
}
// Luma quantization for min/max (2^-20) and for the sum (2^-12), offset by 1
// so that sub-black stays positive.
constant float MK_ST_EXTREME_SCALE = 1048576.0f, MK_ST_SUM_SCALE = 4096.0f;

// ---------------------------------------------------------------- shared

// One pixel of a stage: its R'G'B', the Y' the scope draws (its colorimetry's
// weights) and the stage Y' its statistics measure.
struct mk_ScopeSample {
  float3 rgb;
  float y, stageY;
};

// Rec. ITU-R BT.709-6 item 3.2 luma weights, which the picture pass gives a LUT result.
constant float3 MK_SCOPE_LUMA_709 = float3(.2126f, .7152f, .0722f);

// With no LUT on the stage and the frame's own matrix, the scope's Y' is the
// decoded transport luma, exact at integral codes; otherwise mk_luma, exact for
// neutrals. The statistics' Y' follows the picture's zebras, IRE and clip
// indicators (mk_stageLuma) whatever the colorimetry: the transport luma where
// no LUT touched the stage, Rec.709 Y' of a LUT result.
inline mk_ScopeSample mk_scopeSample(texture2d<uint, access::read> packed, texture2d<float, access::read> luma,
                                     texture2d<float, access::read> chroma, texture3d<float, access::sample> burnLUT,
                                     texture3d<float, access::sample> monitorLUT, uint2 xy,
                                     constant mk_FrameParams& frame, constant mk_LUTParams& burn,
                                     constant mk_LUTParams& monitor, constant mk_ScopeParams& p, float3 inverse) {
  float4 d = mk_decode(packed, luma, chroma, xy, frame, inverse);
  float3 rgb = d.rgb;
  bool burned = p.shape.z >= 1 && p.luts.x, monitored = p.shape.z == 2 && p.luts.y;
  if (burned) rgb = mk_applyLUT(rgb, burnLUT, burn);
  if (monitored) rgb = mk_applyLUT(rgb, monitorLUT, monitor);
  float stageY = burned || monitored ? mk_luma(rgb, MK_SCOPE_LUMA_709) : d.w;
  return {rgb, p.weights.w != 0 ? d.w : mk_luma(rgb, p.weights.xyz), stageY};
}

// Uniform bins over [low, low + n / scale). Out-of-range values land in the
// end bins so clipping stays visible; NaN lands in bin 0 (fmax semantics).
inline uint mk_levelBin(float v, float low, float scale, uint n) {
  return uint(clamp(floor((v - low) * scale), 0.0f, float(n - 1)));
}

// Two 16-bit counters per word. Lanes of a SIMD-group that hit the same bin
// as the first active lane add once, so flat areas cost one atomic per
// SIMD-group instead of 32 serialized ones.
inline void mk_addPacked(threadgroup atomic_uint* words, uint bin) {
  uint leader = simd_broadcast_first(bin);
  uint unit = 1u << ((bin & 1u) << 4);
  if (bin == leader) {
    // Count only lanes that target this bin.  Using ballot(true) here counts
    // every active lane in the SIMD group and folds unrelated bins into the
    // leader whenever a group straddles multiple bins.
    uint n = popcount(uint(uint64_t(simd_ballot(bin == leader))));
    if (simd_is_first()) atomic_fetch_add_explicit(&words[bin >> 1], unit * n, memory_order_relaxed);
  } else {
    atomic_fetch_add_explicit(&words[bin >> 1], unit, memory_order_relaxed);
  }
}

inline void mk_addDevice(device atomic_uint* bins, uint bin, uint amount) {
  uint leader = simd_broadcast_first(bin);
  if (bin == leader) {
    uint total = simd_sum(amount);
    if (simd_is_first()) atomic_fetch_add_explicit(&bins[bin], total, memory_order_relaxed);
  } else {
    atomic_fetch_add_explicit(&bins[bin], amount, memory_order_relaxed);
  }
}

// Per-thread statistics, reduced per SIMD-group, then per threadgroup, then
// merged into the device slot by one thread.
struct mk_ScopeStats {
  uint count, minInv, maxQ, sum;
  uint4 high, low;
};

inline mk_ScopeStats mk_statsInit() { return {0, 0, 0, 0, uint4(0), uint4(0)}; }

inline void mk_statsAdd(thread mk_ScopeStats& s, float3 rgb, float y, constant mk_ScopeParams& p) {
  float yc = clamp(y, -1.0f, 3.0f);
  uint q = uint((yc + 1) * MK_ST_EXTREME_SCALE);
  s.minInv = max(s.minInv, ~q);
  s.maxQ = max(s.maxQ, q);
  s.sum += uint(rint((yc + 1) * MK_ST_SUM_SCALE));
  // In percent, the same operations as the picture pass's clip indicators
  // (mk_stage(…) * 100 >= level), so both classify every pixel alike.
  float4 v = float4(rgb, y) * 100;
  s.high += uint4(v >= p.clip.x);
  s.low += uint4(v <= p.clip.y);
  s.count++;
}

inline void mk_add64(device atomic_uint* words, uint lo, uint value) {
  if (value == 0) return;
  uint old = atomic_fetch_add_explicit(&words[lo], value, memory_order_relaxed);
  // The add that wraps the low word carries exactly once.
  if (old + value < old) atomic_fetch_add_explicit(&words[lo + 1], 1u, memory_order_relaxed);
}

// Call from uniform control flow with every thread of the threadgroup.
inline void mk_statsFlush(thread mk_ScopeStats& s, threadgroup atomic_uint* t, device atomic_uint* slot,
                          uint tid) {
  uint count = simd_sum(s.count), sum = simd_sum(s.sum);
  uint minInv = simd_max(s.minInv), maxQ = simd_max(s.maxQ);
  uint4 high = simd_sum(s.high), low = simd_sum(s.low);
  if (simd_is_first()) {
    atomic_fetch_add_explicit(&t[0], count, memory_order_relaxed);
    atomic_fetch_add_explicit(&t[1], sum, memory_order_relaxed);
    atomic_fetch_max_explicit(&t[2], minInv, memory_order_relaxed);
    atomic_fetch_max_explicit(&t[3], maxQ, memory_order_relaxed);
    for (uint i = 0; i < 4; i++) {
      atomic_fetch_add_explicit(&t[4 + i], high[i], memory_order_relaxed);
      atomic_fetch_add_explicit(&t[8 + i], low[i], memory_order_relaxed);
    }
  }
  threadgroup_barrier(mem_flags::mem_threadgroup);
  if (tid == 0) {
    uint n = atomic_load_explicit(&t[0], memory_order_relaxed);
    if (n == 0) return;
    atomic_fetch_add_explicit(&slot[MK_ST_COUNT], n, memory_order_relaxed);
    mk_add64(slot, MK_ST_SUM_LO, atomic_load_explicit(&t[1], memory_order_relaxed));
    atomic_fetch_max_explicit(&slot[MK_ST_MIN], atomic_load_explicit(&t[2], memory_order_relaxed), memory_order_relaxed);
    atomic_fetch_max_explicit(&slot[MK_ST_MAX], atomic_load_explicit(&t[3], memory_order_relaxed), memory_order_relaxed);
    for (uint i = 0; i < 4; i++) {
      uint h = atomic_load_explicit(&t[4 + i], memory_order_relaxed);
      uint l = atomic_load_explicit(&t[8 + i], memory_order_relaxed);
      if (h) atomic_fetch_add_explicit(&slot[MK_ST_HIGH + i], h, memory_order_relaxed);
      if (l) atomic_fetch_add_explicit(&slot[MK_ST_LOW + i], l, memory_order_relaxed);
    }
  }
}

// Edge threadgroups of a non-uniform dispatch can have fewer than 12 threads,
// so every clear is a strided loop.
inline void mk_clearLocal(threadgroup atomic_uint* words, uint count, threadgroup atomic_uint* t, uint tid,
                          uint threads) {
  for (uint i = tid; i < count; i += threads) atomic_store_explicit(&words[i], 0u, memory_order_relaxed);
  for (uint i = tid; i < 12; i += threads) atomic_store_explicit(&t[i], 0u, memory_order_relaxed);
  threadgroup_barrier(mem_flags::mem_threadgroup);
}

#define MK_SCOPE_INPUTS                                                                   \
  texture2d<uint, access::read> packed [[texture(0)]],                                    \
  texture2d<float, access::read> luma [[texture(1)]],                                     \
  texture2d<float, access::read> chroma [[texture(2)]],                                   \
  texture3d<float, access::sample> burnLUT [[texture(3)]],                                \
  texture3d<float, access::sample> monitorLUT [[texture(4)]],                             \
  constant mk_FrameParams& frame [[buffer(0)]], constant mk_LUTParams& burn [[buffer(1)]], \
  constant mk_LUTParams& monitor [[buffer(2)]], constant mk_ScopeParams& p [[buffer(3)]],  \
  device atomic_uint* bins [[buffer(4)]], device atomic_uint* stats [[buffer(5)]]

#define MK_SCOPE_SAMPLE(xy) mk_scopeSample(packed, luma, chroma, burnLUT, monitorLUT, xy, frame, burn, monitor, p, inverse)

// ---------------------------------------------------------------- clear and finalize

// Mirrors MonitorKitScopes.ScopeMaintenanceParameters. Up to three members:
// a fused group's waveform, histogram and vectorscope, or one accumulator.
struct mk_ScopeMaintain {
  uint4 words;      // xyz: uint4 words of each member's bins to clear, w: members present (bit k: member k)
  uint4 slots;      // xyz: each member's statistics slot (words)
  uint4 generation; // xyz: each member's generation
  uint4 histogram;  // xyz: histogram bins per channel (0: not a histogram), w: member the fused pass measured into + 1 (0: none)
  uint4 channels;   // xyz: channels per member
};

// Function constant 4: a group's clear and finalize (members 0–2). Without it
// only member 0 exists, and members 1 and 2 have no bindings.
constant bool mk_maintainGroup [[function_constant(4)]];

constant uint mk_maintainMembers = mk_maintainGroup ? 3 : 1;

#define MK_MAINTAIN_SLOT(k) ((mk_maintainGroup ? ((k) == 0 ? s0 : ((k) == 1 ? s1 : s2)) : s0) + m.slots[k])

// Zeroes every member's bins and opens their statistics slots. A slot is a
// seqlock the host reads at any time: its END stamp is invalidated before any
// other word changes, and mk_scopeFinalize writes it last.
kernel void mk_scopeClear(constant mk_ScopeMaintain& m [[buffer(3)]], device uint4* b0 [[buffer(4)]],
                          device uint4* b1 [[buffer(6), function_constant(mk_maintainGroup)]],
                          device uint4* b2 [[buffer(7), function_constant(mk_maintainGroup)]],
                          device atomic_uint* s0 [[buffer(5)]],
                          device atomic_uint* s1 [[buffer(12), function_constant(mk_maintainGroup)]],
                          device atomic_uint* s2 [[buffer(13), function_constant(mk_maintainGroup)]],
                          uint gid [[thread_position_in_grid]]) {
  if (gid < m.words.x) b0[gid] = uint4(0);
  if (mk_maintainGroup) {
    if (gid < m.words.y) b1[gid] = uint4(0);
    if (gid < m.words.z) b2[gid] = uint4(0);
  }
  uint present = m.words.w;
  // Threadgroup 0 holds every slot word (at least 32 threads per group).
  if (gid < mk_maintainMembers && (present >> gid & 1))
    atomic_store_explicit(&MK_MAINTAIN_SLOT(gid)[MK_ST_END], 0xFFFFFFFFu, memory_order_relaxed);
  threadgroup_barrier(mem_flags::mem_device);
  if (gid < MK_ST_WORDS && gid != MK_ST_END)
    for (uint k = 0; k < mk_maintainMembers; k++)
      if (present >> k & 1)
        atomic_store_explicit(&MK_MAINTAIN_SLOT(k)[gid], gid == MK_ST_BEGIN ? m.generation[k] : 0u, memory_order_relaxed);
}

// Copies a fused pass's statistics from the slot it measured into to the other
// members (words COUNT…LOW+3, which only the accumulation writes), then
// histogram peaks for the renderer's normalization, then each slot's checksum
// and closing stamp.
kernel void mk_scopeFinalize(constant mk_ScopeMaintain& m [[buffer(3)]], device const uint* b0 [[buffer(4)]],
                             device const uint* b1 [[buffer(6), function_constant(mk_maintainGroup)]],
                             device const uint* b2 [[buffer(7), function_constant(mk_maintainGroup)]],
                             device atomic_uint* s0 [[buffer(5)]],
                             device atomic_uint* s1 [[buffer(12), function_constant(mk_maintainGroup)]],
                             device atomic_uint* s2 [[buffer(13), function_constant(mk_maintainGroup)]],
                             uint tid [[thread_index_in_threadgroup]], uint threads [[threads_per_threadgroup]]) {
  uint present = m.words.w, lead = m.histogram.w;
  if (lead != 0 && tid >= MK_ST_COUNT && tid < MK_ST_PEAK) {
    uint v = atomic_load_explicit(&MK_MAINTAIN_SLOT(lead - 1)[tid], memory_order_relaxed);
    for (uint k = 0; k < mk_maintainMembers; k++)
      if ((present >> k & 1) && k != lead - 1) atomic_store_explicit(&MK_MAINTAIN_SLOT(k)[tid], v, memory_order_relaxed);
  }
  for (uint member = 0; member < mk_maintainMembers; member++) {
    uint bins = m.histogram[member];
    if (!(present >> member & 1) || bins == 0) continue;
    device const uint* counts = mk_maintainGroup ? (member == 0 ? b0 : (member == 1 ? b1 : b2)) : b0;
    device atomic_uint* slot = MK_MAINTAIN_SLOT(member);
    for (uint k = 0; k < m.channels[member]; k++) {
      uint peak = 0;
      for (uint i = tid; i < bins; i += threads) peak = max(peak, counts[k * bins + i]);
      peak = simd_max(peak);
      if (simd_is_first()) atomic_fetch_max_explicit(&slot[MK_ST_PEAK + k], peak, memory_order_relaxed);
    }
  }
  threadgroup_barrier(mem_flags::mem_device);
  if (tid < mk_maintainMembers && (present >> tid & 1)) {
    device atomic_uint* slot = MK_MAINTAIN_SLOT(tid);
    uint peak = 0;
    for (uint k = 0; k < 3; k++) peak = max(peak, atomic_load_explicit(&slot[MK_ST_PEAK + k], memory_order_relaxed));
    atomic_store_explicit(&slot[MK_ST_PEAK_ALL], peak, memory_order_relaxed);
    atomic_store_explicit(&slot[MK_ST_CHECK], mk_statsChecksum(slot), memory_order_relaxed);
    atomic_store_explicit(&slot[MK_ST_END], m.generation[tid], memory_order_relaxed);
  }
}

// ---------------------------------------------------------------- shared by the accumulation kernels

// floor(x · C / fw) without an integer divide: a float estimate (z = 1 / fw), corrected by one.
inline uint mk_waveformColumn(uint x, uint C, uint fw, float inverseWidth) {
  uint xc = x * C, column = uint(float(xc) * inverseWidth);
  return column * fw > xc ? column - 1 : ((column + 1) * fw <= xc ? column + 1 : column);
}

// The waveform's per-channel values: Y', Y'CbCr with chroma offset to 0.5, or R'G'B'.
inline float3 mk_waveformValues(float3 rgb, float y, constant mk_ScopeParams& p) {
  return p.shape.y == 0 ? float3(y)
       : (p.shape.y == 3 ? float3(y, (rgb.b - y) * p.chroma.x + .5f, (rgb.r - y) * p.chroma.y + .5f) : rgb);
}

// The vectorscope bin of a pixel, or 0xFFFFFFFE outside the zoomed plane.
inline uint mk_vectorBin(float3 rgb, float y, constant mk_ScopeParams& p) {
  float2 c = float2((rgb.b - y) * p.chroma.x, (rgb.r - y) * p.chroma.y);
  float2 b = floor(c * p.chroma.z + p.chroma.w);
  uint N = p.bins.x;
  return all(b >= 0) && all(b < float(N)) ? uint(b.y) * N + uint(b.x) : 0xFFFFFFFEu;
}

// Adds a threadgroup's private waveform bins (K columns from c0) to the device
// bins. K and C are even, so a local word maps onto one packed device word, or
// onto two adjacent 32-bit bins. Only non-zero words cost an atomic.
inline void mk_mergeWaveform(threadgroup atomic_uint* local, device atomic_uint* bins, constant mk_ScopeParams& p,
                             uint K, uint c0, uint tid, uint threads) {
  uint C = p.bins.x, L = p.bins.y, words = K * L * p.shape.w / 2;
  for (uint i = tid; i < words; i += threads) {
    uint w = atomic_load_explicit(&local[i], memory_order_relaxed);
    if (w == 0) continue;
    uint index = i * 2, column = index % K, rest = index / K;
    uint level = rest % L, k = rest / L;
    uint g = (k * L + level) * C + c0 + column;
    if (p.bins.z) {
      atomic_fetch_add_explicit(&bins[g >> 1], w, memory_order_relaxed);
    } else {
      if (w & 0xFFFFu) atomic_fetch_add_explicit(&bins[g], w & 0xFFFFu, memory_order_relaxed);
      if (w >> 16) atomic_fetch_add_explicit(&bins[g + 1], w >> 16, memory_order_relaxed);
    }
  }
}

inline void mk_mergeHistogram(threadgroup atomic_uint* local, device atomic_uint* bins, uint words, uint tid,
                              uint threads) {
  for (uint i = tid; i < words; i += threads) {
    uint w = atomic_load_explicit(&local[i], memory_order_relaxed);
    if (w & 0xFFFFu) atomic_fetch_add_explicit(&bins[i * 2], w & 0xFFFFu, memory_order_relaxed);
    if (w >> 16) atomic_fetch_add_explicit(&bins[i * 2 + 1], w >> 16, memory_order_relaxed);
  }
}

// ---------------------------------------------------------------- waveform

// Bins: [channel][level][column], columns per channel `C`, levels `L`.
// Each threadgroup owns `K` scope columns (the frame columns that map to
// them) over a band of rows, so its private bins are only K × L × channels.
kernel void mk_scopeWaveform(MK_SCOPE_INPUTS, threadgroup atomic_uint* local [[threadgroup(0)]],
                             uint2 group [[threadgroup_position_in_grid]],
                             uint tid [[thread_index_in_threadgroup]],
                             uint2 size [[threads_per_threadgroup]]) {
  threadgroup atomic_uint t[12];
  uint threads = size.x * size.y;
  uint K = p.tile.x, C = p.bins.x, L = p.bins.y, channels = p.shape.w;
  mk_clearLocal(local, K * L * channels / 2, t, tid, threads);
  float3 inverse = mk_reciprocals(frame);  // MK_SCOPE_SAMPLE's exact quotients

  uint fw = frame.shape.y, fh = frame.shape.z;
  uint c0 = group.x * K, c1 = min(c0 + K, C);
  uint x0 = (c0 * fw + C - 1) / C, x1 = (c1 * fw + C - 1) / C;
  uint y0 = group.y * p.tile.y, y1 = min(y0 + p.tile.y, fh);
  uint tw = x1 - x0, th = y1 > y0 ? y1 - y0 : 0;
  mk_ScopeStats s = mk_statsInit();
  if (tw > 0 && th > 0) {
    // Rows run fastest, so a SIMD-group walks down one column: flat areas
    // fall in one bin and collapse to a single atomic. (Measured faster than
    // row-major order and than per-thread horizontal runs.)
    uint y = tid % th, x = tid / th;
    uint dy = threads % th, dx = threads / th;
    uint n = tw * th;
    for (uint i = tid; i < n; i += threads) {
      uint2 xy = uint2(x0 + x, y0 + y);
      mk_ScopeSample sample = MK_SCOPE_SAMPLE(xy);
      mk_statsAdd(s, sample.rgb, sample.stageY, p);
      uint column = mk_waveformColumn(xy.x, C, fw, p.level.z) - c0;
      float3 v = mk_waveformValues(sample.rgb, sample.y, p);
      for (uint k = 0; k < channels; k++)
        mk_addPacked(local, (k * L + mk_levelBin(v[k], p.level.x, p.level.y, L)) * K + column);
      y += dy;
      x += dx;
      if (y >= th) { y -= th; x++; }
    }
  }
  threadgroup_barrier(mem_flags::mem_threadgroup);
  mk_statsFlush(s, t, stats + p.bins.w, tid);
  mk_mergeWaveform(local, bins, p, K, c0, tid, threads);
}

// ---------------------------------------------------------------- histogram

// Bins: [channel][bin], 32-bit. Each threadgroup counts one tile of the frame
// (at most 65535 pixels, so its packed 16-bit private counters cannot wrap).
kernel void mk_scopeHistogram(MK_SCOPE_INPUTS, threadgroup atomic_uint* local [[threadgroup(0)]],
                              uint2 group [[threadgroup_position_in_grid]],
                              uint tid [[thread_index_in_threadgroup]],
                              uint2 size [[threads_per_threadgroup]]) {
  threadgroup atomic_uint t[12];
  uint threads = size.x * size.y;
  uint B = p.bins.x, channels = p.shape.w;
  uint words = B * channels / 2;
  mk_clearLocal(local, words, t, tid, threads);
  float3 inverse = mk_reciprocals(frame);  // MK_SCOPE_SAMPLE's exact quotients

  uint fw = frame.shape.y, fh = frame.shape.z;
  uint x0 = group.x * p.tile.x, y0 = group.y * p.tile.y;
  uint tw = min(x0 + p.tile.x, fw) - x0, th = min(y0 + p.tile.y, fh) - y0;
  mk_ScopeStats s = mk_statsInit();
  // Work items are short horizontal runs, lanes side by side along the row.
  uint run = p.tile.z, runs = (tw + run - 1) / run;
  uint r = tid % runs, y = tid / runs;
  uint dr = threads % runs, dy = threads / runs;
  uint n = runs * th;
  for (uint i = tid; i < n; i += threads) {
    uint xs = x0 + r * run, xe = min(xs + run, x0 + tw);
    for (uint x = xs; x < xe; x++) {
      mk_ScopeSample sample = MK_SCOPE_SAMPLE(uint2(x, y0 + y));
      mk_statsAdd(s, sample.rgb, sample.stageY, p);
      float3 v = p.shape.y == 0 ? float3(sample.y) : sample.rgb;
      for (uint k = 0; k < channels; k++) mk_addPacked(local, k * B + mk_levelBin(v[k], p.level.x, p.level.y, B));
    }
    r += dr;
    y += dy;
    if (r >= runs) { r -= runs; y++; }
  }
  threadgroup_barrier(mem_flags::mem_threadgroup);
  mk_statsFlush(s, t, stats + p.bins.w, tid);
  mk_mergeHistogram(local, bins, words, tid, threads);
}

// ---------------------------------------------------------------- vectorscope

// Bins: [Cr row, bottom to top][Cb column], 32-bit, side `N`. The plane is too
// large for threadgroup memory, so each thread walks a short run of pixels,
// folds repeated bins into one count and adds runs through SIMD-aggregated
// device atomics. Samples outside the zoomed plane are dropped.
kernel void mk_scopeVector(MK_SCOPE_INPUTS, uint2 gid [[thread_position_in_grid]],
                           uint tid [[thread_index_in_threadgroup]], uint2 size [[threads_per_threadgroup]]) {
  threadgroup atomic_uint t[12];
  mk_clearLocal(t, 0, t, tid, size.x * size.y);

  uint fw = frame.shape.y, fh = frame.shape.z, run = p.tile.z;
  float3 inverse = mk_reciprocals(frame);  // MK_SCOPE_SAMPLE's exact quotients
  mk_ScopeStats s = mk_statsInit();
  uint x0 = gid.x * run;
  if (gid.y < fh && x0 < fw) {
    uint x1 = min(x0 + run, fw);
    uint current = 0xFFFFFFFFu, count = 0;
    for (uint x = x0; x < x1; x++) {
      mk_ScopeSample sample = MK_SCOPE_SAMPLE(uint2(x, gid.y));
      mk_statsAdd(s, sample.rgb, sample.stageY, p);
      uint bin = mk_vectorBin(sample.rgb, sample.y, p);
      if (bin == current) {
        count++;
      } else {
        if (count && current < 0xFFFFFFFEu) mk_addDevice(bins, current, count);
        current = bin;
        count = 1;
      }
    }
    if (count && current < 0xFFFFFFFEu) mk_addDevice(bins, current, count);
  }
  threadgroup_barrier(mem_flags::mem_threadgroup);
  mk_statsFlush(s, t, stats + p.bins.w, tid);
}

// ---------------------------------------------------------------- fused

// Several scopes of one stage in one pass: each pixel is decoded, put through
// the stage's LUTs and measured once, then added to every scope's bins. The
// scopes present are function constants 1–3. With a waveform the threadgroups
// tile like mk_scopeWaveform and the histogram's private bins follow the
// waveform's in threadgroup memory; without one they tile like
// mk_scopeHistogram. The vectorscope adds through device atomics. `p` (the
// lead scope) carries the stage, LUTs, weights and clip levels, which every
// fused scope shares, and its statistics buffer (14) receives the statistics.
constant bool mk_fuseWaveform [[function_constant(1)]];
constant bool mk_fuseHistogram [[function_constant(2)]];
constant bool mk_fuseVector [[function_constant(3)]];

// Pixels per work item: a short run down one column, so a thread folds
// repeated vectorscope bins while a SIMD-group's lanes walk neighbouring runs
// of the same column (flat areas collapse into one atomic per bin).
constant uint MK_FUSED_RUN = 4;

kernel void mk_scopeFused(texture2d<uint, access::read> packed [[texture(0)]],
                          texture2d<float, access::read> luma [[texture(1)]],
                          texture2d<float, access::read> chroma [[texture(2)]],
                          texture3d<float, access::sample> burnLUT [[texture(3)]],
                          texture3d<float, access::sample> monitorLUT [[texture(4)]],
                          constant mk_FrameParams& frame [[buffer(0)]], constant mk_LUTParams& burn [[buffer(1)]],
                          constant mk_LUTParams& monitor [[buffer(2)]], constant mk_ScopeParams& p [[buffer(3)]],
                          device atomic_uint* stats [[buffer(14)]],
                          device atomic_uint* wbins [[buffer(4), function_constant(mk_fuseWaveform)]],
                          device atomic_uint* hbins [[buffer(6), function_constant(mk_fuseHistogram)]],
                          device atomic_uint* vbins [[buffer(7), function_constant(mk_fuseVector)]],
                          constant mk_ScopeParams& wp [[buffer(8), function_constant(mk_fuseWaveform)]],
                          constant mk_ScopeParams& hp [[buffer(9), function_constant(mk_fuseHistogram)]],
                          constant mk_ScopeParams& vp [[buffer(10), function_constant(mk_fuseVector)]],
                          threadgroup atomic_uint* local [[threadgroup(0)]],
                          uint2 group [[threadgroup_position_in_grid]], uint tid [[thread_index_in_threadgroup]],
                          uint2 size [[threads_per_threadgroup]]) {
  threadgroup atomic_uint t[12];
  uint threads = size.x * size.y;
  uint K = 0, C = 1, L = 1, wch = 0, wwords = 0;
  if (mk_fuseWaveform) {
    K = wp.tile.x;
    C = wp.bins.x;
    L = wp.bins.y;
    wch = wp.shape.w;
    wwords = K * L * wch / 2;
  }
  uint B = 1, hch = 0, hwords = 0;
  // The histogram's words start 16-byte aligned after the waveform's.
  uint hoffset = (wwords + 3) & ~3u;
  if (mk_fuseHistogram) {
    B = hp.bins.x;
    hch = hp.shape.w;
    hwords = B * hch / 2;
  }
  threadgroup atomic_uint* hlocal = local + hoffset;
  mk_clearLocal(local, hoffset + hwords, t, tid, threads);
  float3 inverse = mk_reciprocals(frame);  // MK_SCOPE_SAMPLE's exact quotients

  uint fw = frame.shape.y, fh = frame.shape.z;
  uint x0, x1, y0, y1, c0 = 0;
  if (mk_fuseWaveform) {
    c0 = group.x * K;
    uint c1 = min(c0 + K, C);
    x0 = (c0 * fw + C - 1) / C;
    x1 = (c1 * fw + C - 1) / C;
    y0 = group.y * wp.tile.y;
    y1 = min(y0 + wp.tile.y, fh);
  } else {
    x0 = group.x * hp.tile.x;
    x1 = min(x0 + hp.tile.x, fw);
    y0 = group.y * hp.tile.y;
    y1 = min(y0 + hp.tile.y, fh);
  }
  uint tw = x1 > x0 ? x1 - x0 : 0, th = y1 > y0 ? y1 - y0 : 0;
  uint runs = (th + MK_FUSED_RUN - 1) / MK_FUSED_RUN, items = tw * runs;
  mk_ScopeStats s = mk_statsInit();
  uint current = 0xFFFFFFFFu, count = 0;
  for (uint i = tid; i < items; i += threads) {
    uint x = x0 + i / runs, ys = y0 + (i % runs) * MK_FUSED_RUN, ye = min(ys + MK_FUSED_RUN, y1);
    uint column = mk_fuseWaveform ? mk_waveformColumn(x, C, fw, wp.level.z) - c0 : 0;
    for (uint y = ys; y < ye; y++) {
      mk_ScopeSample sample = MK_SCOPE_SAMPLE(uint2(x, y));
      mk_statsAdd(s, sample.rgb, sample.stageY, p);
      if (mk_fuseWaveform) {
        float3 v = mk_waveformValues(sample.rgb, sample.y, wp);
        for (uint k = 0; k < wch; k++)
          mk_addPacked(local, (k * L + mk_levelBin(v[k], wp.level.x, wp.level.y, L)) * K + column);
      }
      if (mk_fuseHistogram) {
        float3 v = hp.shape.y == 0 ? float3(sample.y) : sample.rgb;
        for (uint k = 0; k < hch; k++) mk_addPacked(hlocal, k * B + mk_levelBin(v[k], hp.level.x, hp.level.y, B));
      }
      if (mk_fuseVector) {
        uint bin = mk_vectorBin(sample.rgb, sample.y, vp);
        if (bin == current) {
          count++;
        } else {
          if (count && current < 0xFFFFFFFEu) mk_addDevice(vbins, current, count);
          current = bin;
          count = 1;
        }
      }
    }
  }
  if (mk_fuseVector && count && current < 0xFFFFFFFEu) mk_addDevice(vbins, current, count);
  threadgroup_barrier(mem_flags::mem_threadgroup);
  mk_statsFlush(s, t, stats + p.bins.w, tid);
  if (mk_fuseWaveform) mk_mergeWaveform(local, wbins, wp, K, c0, tid, threads);
  if (mk_fuseHistogram) mk_mergeHistogram(hlocal, hbins, hwords, tid, threads);
}

// ---------------------------------------------------------------- rendering
//
// Drawing is two steps. mk_scopeResolve turns the bins into trace intensity
// (the density curve after gain, per channel), once per accumulation, display
// change or plot size. On an axis the plot shows at bin resolution or larger
// the trace holds one texel per bin and the fragment shader samples it
// bilinearly; on a minified axis the resolve already took the maximum of the
// bins under each plot pixel, so the fragment reads that pixel's texel. Plot
// pixels and their texels are matched in integers (mk_ScopeDraw.pixels), and
// the footprints tile the bins exactly, so no non-empty bin can vanish. Either
// way a draw is one sample per pixel.

// Mirrors MonitorKitScopes.ScopeResolveParameters.
struct mk_ScopeResolve {
  uint4 shape;      // x: kind, y: channels, z: bins packed 16-bit, w: statistics slot (words)
  uint4 bins;       // x: columns per channel | bins | side, y: levels | 1 | side, z: waveform frame width (0: none), w: frame height
  uint4 size;       // xy: trace texels written, zw: source texels per axis
  float4 intensity; // x: density per count (waveform: per count per frame column), y: curve (0 log, 1 gamma), z: histogram gain, w: histogram log scale
  uint4 reduce;     // xy: plot pixels a minified axis is reduced to (0: one texel per source texel), z: parade panels across x (1 or 3), w: footprints start half a source texel in
};

// Mirrors MonitorKitScopes.ScopeShape. Positions in viewport pixels.
struct mk_ScopeShape {
  float4 geometry; // line: x0, y0, x1, y1; circle: cx, cy, r; box: cx, cy, half size
  float4 style;    // x: type (0 line, 1 circle, 2 box), y: opacity, z: half width
};

constant uint MK_SCOPE_MAX_SHAPES = 64;

// Mirrors MonitorKitScopes.ScopeDrawParameters.
struct mk_ScopeDraw {
  float4 viewport;   // x, y, width, height in target pixels
  float4 plot;       // x, y, width, height in viewport pixels
  uint4 shape;       // x: kind, y: mode, z: channels
  uint4 flags;       // x: has data, y: sRGB target, z: trace (0 phosphor, 1 white, 2 colorized, 3 legacy: no bloom), w: reduced axes (bit 0 x, bit 1 y)
  float4 intensity;  // x: brightness
  float4 background; // x: opacity, y: graticule opacity
  float4 chroma;     // x: kr, y: kb, z: chroma per plot half side
  float4 traceMap;   // xy: trace texels per unit of plot on an axis drawn from the bins, zw: texel offset
  uint4 pixels;      // xy: the plot's first pixel, zw: one past its last (viewport pixels whose centre is inside)
  float4 colors[3];
  float4 graticuleColor;
  float4 encode;        // x: output transfer (0 as authored, 1 BT.1886, 2 sRGB, 3 gamma 2.2, 4 linear, 5 PQ, 6 HLG), y: graphics white cd/m², z: HLG peak, w: HLG system gamma
  float4 toTarget[3];   // linear BT.709 to the target primaries, by rows
  float4 targetWeights; // luminance weights of the target primaries
};

// Mirrors MonitorKitScopes.ScopeGraticuleParameters.
struct mk_ScopeGraticuleParams {
  float4 plot; // x, y, width, height in viewport pixels
  float4 size; // xy: viewport size in pixels, z: shape count
  mk_ScopeShape shapes[MK_SCOPE_MAX_SHAPES];
};

// Render pipelines are specialized per scope kind and mode (function
// constants 10 and 11), so each holds one scope's drawing. Left undefined,
// the values are read from mk_ScopeDraw at run time.
constant uint mk_drawKindConstant [[function_constant(10)]];
constant uint mk_drawModeConstant [[function_constant(11)]];
constant bool mk_drawKindDefined = is_function_constant_defined(mk_drawKindConstant);
constant bool mk_drawModeDefined = is_function_constant_defined(mk_drawModeConstant);

struct mk_ScopeVertexOut { float4 position [[position]]; };

vertex mk_ScopeVertexOut mk_scopeVertex(uint id [[vertex_id]]) {
  float2 uv = float2((id << 1) & 2, id & 2);
  mk_ScopeVertexOut out;
  out.position = float4(uv * float2(2, -2) + float2(-1, 1), 0, 1);
  return out;
}

// Mirrors ScopeIntensityCurve.value(density:).
inline float mk_scopeIntensity(float x, uint curve) {
  x = max(x, 0.0f);
  return curve == 0 ? min(1.0f, log(1 + 16 * x) / log(257.0f)) : pow(min(x / 16, 1.0f), 1 / 2.2f);
}

inline uint mk_binCount(device const uint* bins, uint index, bool packed) {
  return packed ? (bins[index >> 1] >> ((index & 1u) << 4)) & 0xFFFFu : bins[index];
}

// Frame columns feeding waveform column `c`: when the frame width is not a
// multiple of the column count, neighbouring columns hold different pixel
// counts and would otherwise render as stripes.
inline uint mk_frameColumns(uint c, uint columns, uint frameWidth) {
  return ((c + 1) * frameWidth + columns - 1) / columns - (c * frameWidth + columns - 1) / columns;
}

// The trace of one source texel: intensity per channel before brightness, or
// the histogram height (0…1 of the panel). A frame narrower than the waveform
// leaves some scope columns empty; then the source has one texel column per
// frame column, read from the scope column that frame column was binned into,
// so empty columns are never drawn.
// Channels k0 up to k1 are computed; the others are 0.
inline float4 mk_traceTexel(constant mk_ScopeResolve& r, device const uint* bins, float peak, uint2 xy, uint k0,
                            uint k1) {
  uint columns = r.bins.x, rows = r.bins.y;
  float4 v = float4(0);
  if (r.shape.x == MK_SCOPE_HISTOGRAM) {
    for (uint k = k0; k < k1; k++) {
      float count = float(bins[k * columns + xy.x]);
      float h = r.intensity.w != 0 ? log(1 + count) / log(1 + peak) : count / peak;
      v[k] = min(1.0f, h * r.intensity.z);
    }
    return v;
  }
  uint column = xy.x;
  float weight = 1;
  uint fw = r.bins.z;
  if (fw != 0 && fw < columns) {
    column = xy.x * columns / fw;
  } else if (fw != 0) {
    weight = 1.0f / float(max(mk_frameColumns(column, columns, fw), 1u));
  }
  bool packed = r.shape.z != 0;
  for (uint k = k0; k < k1; k++) {
    float count = float(mk_binCount(bins, (k * rows + xy.y) * columns + column, packed));
    v[k] = mk_scopeIntensity(count * weight * r.intensity.x, uint(r.intensity.y));
  }
  return v;
}

// The source texels [first, end) that plot pixel `j` of `P` overlaps on an
// axis of `n` source texels (n >= P on a reduced axis), in integers. A texel
// straddling two pixels lights both, the first pixel starts at 0 and the last
// ends at n, so every source texel reaches the trace. With `centred` the pixel
// edges sit half a source texel in, as the vectorscope's bins (centred on whole
// chroma steps) are drawn.
inline uint2 mk_footprint(uint j, uint P, uint n, uint centred) {
  uint first = min((2 * j * n + centred * P) / (2 * P), n - 1);
  uint end = (2 * (j + 1) * n + centred * P + 2 * P - 1) / (2 * P);
  return uint2(first, clamp(end, first + 1, n));
}

// Parade panel of plot pixel `i` of `W`: the third its centre falls in,
// min(floor((i + 0.5) · 3 / W), 2), in integers. mk_panelStart(k, W) is the
// panel's first pixel (the least i in panel k or later).
inline uint mk_panelOf(uint i, uint W) { return min((6 * i + 3) / (2 * W), 2u); }
inline uint mk_panelStart(uint k, uint W) { return (2 * k * W + 2) / 6; }

// One trace texel: the maximum over the source texels under its footprint
// (exactly one on an axis drawn from the bins). On a reduced parade x axis the
// texel is the panel's own pixel index; panels may differ by a pixel, so each
// channel is reduced over its own panel's footprint.
kernel void mk_scopeResolve(constant mk_ScopeResolve& r [[buffer(0)]], device const uint* bins [[buffer(1)]],
                            device const uint* stats [[buffer(2)]],
                            texture2d<float, access::write> trace [[texture(0)]], uint2 gid [[thread_position_in_grid]]) {
  if (gid.x >= r.size.x || gid.y >= r.size.y) return;
  // One scale for every histogram channel, so their heights compare.
  float peak = r.shape.x == MK_SCOPE_HISTOGRAM ? float(max(stats[r.shape.w + MK_ST_PEAK_ALL], 1u)) : 1;
  uint2 n = r.size.zw;
  uint W = r.reduce.x, centred = r.reduce.w;
  uint2 ry = r.reduce.y != 0 ? mk_footprint(gid.y, r.reduce.y, n.y, centred) : uint2(gid.y, gid.y + 1);
  float4 v = float4(0);
  if (W != 0 && r.reduce.z == 3) {
    for (uint k = 0; k < 3; k++) {
      uint start = mk_panelStart(k, W), P = (k == 2 ? W : mk_panelStart(k + 1, W)) - start;
      if (gid.x >= P) continue;
      uint2 rx = mk_footprint(gid.x, P, n.x, centred);
      for (uint y = ry.x; y < ry.y; y++)
        for (uint x = rx.x; x < rx.y; x++) v[k] = max(v[k], mk_traceTexel(r, bins, peak, uint2(x, y), k, k + 1)[k]);
    }
  } else {
    uint2 rx = W != 0 ? mk_footprint(gid.x, W, n.x, centred) : uint2(gid.x, gid.x + 1);
    for (uint y = ry.x; y < ry.y; y++)
      for (uint x = rx.x; x < rx.y; x++) v = max(v, mk_traceTexel(r, bins, peak, uint2(x, y), 0, r.shape.y));
  }
  trace.write(v, gid);
}

// The trace at plot fraction `f` (bottom to top on y): a bilinear sample on an
// axis drawn from the bins, this plot pixel's own texel `texel` on a reduced
// one. The plot's edge texels extend to its edge.
inline float4 mk_sampleTrace(texture2d<float, access::sample> trace, float2 f, uint2 texel, constant mk_ScopeDraw& d) {
  constexpr sampler bilinear(coord::pixel, filter::linear, address::clamp_to_edge);
  float2 position = f * d.traceMap.xy + d.traceMap.zw;
  if (d.flags.w & 1) position.x = float(texel.x) + .5f;
  if (d.flags.w & 2) position.y = float(texel.y) + .5f;
  return trace.sample(bilinear, position);
}

inline float3 mk_traceColor(float3 base, float i, uint style) {
  // Dense areas bloom towards white, like a phosphor trace; style 3 (the
  // legacy palette) is the colour scaled by intensity, as MonitorTools drew it.
  return i * mix(base, float3(1), style == 3 ? 0.0f : (style == 0 ? i * i * .6f : i * i * .3f));
}

inline float mk_shapeDistance(mk_ScopeShape s, float2 p) {
  uint type = uint(s.style.x);
  if (type == 0) {
    float2 a = s.geometry.xy, b = s.geometry.zw, ab = b - a;
    float t = clamp(dot(p - a, ab) / max(dot(ab, ab), 1e-6f), 0.0f, 1.0f);
    return length(p - (a + t * ab));
  }
  if (type == 1) return abs(length(p - s.geometry.xy) - s.geometry.z);
  float2 q = abs(p - s.geometry.xy) - s.geometry.z;
  return abs(length(max(q, 0.0f)) + min(max(q.x, q.y), 0.0f));
}

inline float mk_srgbToLinear(float v) {
  v = clamp(v, 0.0f, 1.0f);
  return v <= .04045f ? v / 12.92f : pow((v + .055f) / 1.055f, 2.4f);
}

// The scope's colours are authored as BT.709 SDR display R'G'B' at graphics
// white. On another output they are taken to display light through BT.1886
// (black 0, L = V^2.4), converted to the target primaries and encoded, as
// MonitorColorPipeline.overlayColor does on the CPU: graphics white lands at
// d.encode.y cd/m² (Report ITU-R BT.2408-8 Table 1: 203, which is 58% PQ and
// 75% HLG) or 1.0 in extended linear. The hardware's fast exp2/log2 powers
// (relative error about 1e-6, far under a 10-bit code) keep it a few ALU per pixel.
inline float3 mk_scopeEncode(float3 c, constant mk_ScopeDraw& d) {
  float3 l = fast::pow(saturate(c), 2.4f);
  l = float3(dot(d.toTarget[0].xyz, l), dot(d.toTarget[1].xyz, l), dot(d.toTarget[2].xyz, l));
  uint tf = uint(d.encode.x);
  if (tf == 4) return l;
  if (tf == 5) {
    // SMPTE ST 2084 inverse EOTF.
    const float m1 = 2610.0f / 16384, m2 = 2523.0f / 4096 * 128, c1 = 3424.0f / 4096, c2 = 2413.0f / 4096 * 32,
                c3 = 2392.0f / 4096 * 32;
    float3 y = fast::pow(clamp(l * d.encode.y, 0.0f, 10000.0f) / 10000, m1);
    return fast::pow((c1 + c2 * y) / (1 + c3 * y), m2);
  }
  if (tf == 6) {
    // BT.2100 HLG inverse EOTF: display light clipped to the peak, the inverse
    // OOTF E = F / (peak · (Yd / peak)^((γ - 1) / γ)), then the OETF (Table 5).
    float peak = d.encode.z, gamma = d.encode.w;
    float3 f = clamp(l * d.encode.y, 0.0f, peak);
    float yd = dot(d.targetWeights.xyz, f);
    float3 e = yd > 0 ? min(f / (peak * fast::pow(yd / peak, (gamma - 1) / gamma)), 1.0f) : float3(0);
    const float a = .17883277f, b = 1 - 4 * a, cc = .5f - a * log(4 * a);
    return select(a * fast::log(max(12 * e - b, 1e-6f)) + cc, sqrt(3 * e), e <= 1.0f / 12);
  }
  l = saturate(l);
  if (tf == 2) return select(1.055f * fast::pow(l, 1 / 2.4f) - .055f, l * 12.92f, l <= .0031308f);
  if (tf == 3) return fast::pow(l, 1 / 2.2f);
  return fast::pow(l, 1 / 2.4f);
}

// Graticule coverage, rasterized into an r8 texture only when the graticule or
// the viewport size changes; the scope's fragment shader reads one texel. One
// quad per shape covers everything the shape can touch (its half width plus a
// pixel of anti-aliasing), and the shapes combine with a max blend, so the
// cost follows the lines drawn rather than viewport pixels × shapes.
struct mk_GraticuleOut {
  float4 position [[position]];
  uint shape [[flat]];
};

vertex mk_GraticuleOut mk_graticuleVertex(uint vid [[vertex_id]], uint iid [[instance_id]],
                                          constant mk_ScopeGraticuleParams& g [[buffer(0)]]) {
  mk_ScopeShape s = g.shapes[iid];
  float e = s.style.z + 1;
  // Triangle strip corners: (-1, -1), (1, -1), (-1, 1), (1, 1).
  float2 corner = float2(float(vid & 1), float(vid >> 1)) * 2 - 1;
  float2 p;
  if (uint(s.style.x) == 0) {
    float2 a = s.geometry.xy, b = s.geometry.zw, ab = b - a;
    float len = length(ab);
    float2 t = len > 1e-6f ? ab / len : float2(1, 0), n = float2(-t.y, t.x);
    p = (a + b) * .5f + t * corner.x * (len * .5f + e) + n * corner.y * e;
  } else {
    p = s.geometry.xy + corner * (s.geometry.z + e);
  }
  mk_GraticuleOut out;
  out.position = float4(p.x / g.size.x * 2 - 1, 1 - p.y / g.size.y * 2, 0, 1);
  out.shape = iid;
  return out;
}

// Coverage at the pixel centre, clipped to the plot, so a zoomed vectorscope
// draws nothing in the side margins.
fragment float4 mk_graticuleFragment(mk_GraticuleOut in [[stage_in]],
                                     constant mk_ScopeGraticuleParams& g [[buffer(0)]]) {
  float2 px = in.position.xy;
  if (any(px < g.plot.xy) || any(px > g.plot.xy + g.plot.zw)) return float4(0);
  mk_ScopeShape s = g.shapes[in.shape];
  return float4(clamp(s.style.z + .5f - mk_shapeDistance(s, px), 0.0f, 1.0f) * s.style.y);
}

fragment float4 mk_scopeFragment(mk_ScopeVertexOut in [[stage_in]], constant mk_ScopeDraw& d [[buffer(0)]],
                                 texture2d<float, access::read> graticule [[texture(0)]],
                                 texture2d<float, access::sample> trace [[texture(1)]]) {
  float2 px = in.position.xy - d.viewport.xy;
  float2 uv = (px - d.plot.xy) / d.plot.zw;
  uint2 pixel = uint2(max(px, 0.0f));
  float3 light = float3(0);
  if (d.flags.x && all(pixel >= d.pixels.xy) && all(pixel < d.pixels.zw)) {
    uint kind = mk_drawKindDefined ? mk_drawKindConstant : d.shape.x;
    uint mode = mk_drawModeDefined ? mk_drawModeConstant : d.shape.y;
    float brightness = d.intensity.x;
    // On a reduced axis, this pixel's texel: from the plot's left and bottom.
    uint2 texel = uint2(pixel.x - d.pixels.x, d.pixels.w - 1 - pixel.y);
    if (kind == MK_SCOPE_WAVEFORM) {
      bool parade = mode == 2 || mode == 3;
      float u = uv.x;
      uint first = 0, last = mode == 0 ? 1 : 3;
      if (parade) {
        if (d.flags.w & 1) {
          // The resolve's panel split, in integers, and the pixel's index in its panel.
          uint W = d.pixels.z - d.pixels.x;
          first = mk_panelOf(texel.x, W);
          texel.x -= mk_panelStart(first, W);
        } else {
          first = min(uint(u * 3), 2u);
        }
        last = first + 1;
        u = u * 3 - float(first);
      }
      float4 v = mk_sampleTrace(trace, float2(u, 1 - uv.y), texel, d);
      for (uint k = first; k < last; k++) light += mk_traceColor(d.colors[k].rgb, min(1.0f, v[k] * brightness), d.flags.z);
    } else if (kind == MK_SCOPE_VECTOR) {
      float i = min(1.0f, mk_sampleTrace(trace, float2(uv.x, 1 - uv.y), texel, d).r * brightness);
      float3 base = d.colors[0].rgb;
      if (d.flags.z == 2) {
        // The hue this point measures, at a fixed luma, normalized to its peak.
        float2 c = float2(uv.x * 2 - 1, 1 - uv.y * 2) * d.chroma.z;
        float y = .5f, kr = d.chroma.x, kb = d.chroma.y;
        float r = y + 2 * (1 - kr) * c.y, b = y + 2 * (1 - kb) * c.x;
        float3 rgb = max(float3(r, (y - kr * r - kb * b) / (1 - kr - kb), b), 0.0f);
        base = mix(float3(1), rgb / max(max(rgb.r, max(rgb.g, rgb.b)), 1e-3f), min(1.0f, length(c) * 6));
      }
      light = mk_traceColor(base, i, d.flags.z);
    } else {
      bool parade = mode == 2;
      float v = uv.y;
      uint first = 0, last = mode == 0 ? 1 : 3;
      if (parade) {
        first = min(uint(v * 3), 2u);
        last = first + 1;
        v = v * 3 - float(first);
      }
      float panel = d.plot.w / (parade ? 3 : 1);
      float level = 1 - v;
      float4 heights = mk_sampleTrace(trace, float2(uv.x, 0), texel, d);
      for (uint k = first; k < last; k++) {
        float h = heights[k];
        float fill = clamp((h - level) * panel + .5f, 0.0f, 1.0f);
        float edge = clamp(1.5f - abs(h - level) * panel, 0.0f, 1.0f) * step(1e-6f, h);
        light += d.colors[k].rgb * (fill * .5f + edge * .5f) * brightness;
      }
    }
  }
  uint2 texel = uint2(max(px, 0.0f));
  float g = d.background.y > 0 && texel.x < graticule.get_width() && texel.y < graticule.get_height()
    ? graticule.read(texel).r : 0;
  // Premultiplied: background, graticule over it, then the trace as emitted light.
  float alpha = d.background.x;
  float ga = g * d.background.y;
  float3 color = d.graticuleColor.rgb * ga;
  alpha = ga + alpha * (1 - ga);
  light = min(light, float3(1));
  color = min(color + light, float3(1));
  alpha = alpha + (1 - alpha) * max(light.r, max(light.g, light.b));
  // Encoded unpremultiplied, so coverage and opacity blend as on an SDR layer.
  // Black (most of a scope) stays black in every encoding.
  if (d.encode.x != 0 && alpha > 0 && any(color > 0)) color = mk_scopeEncode(color / alpha, d) * alpha;
  // sRGB targets re-encode on store; exact where the scope is opaque.
  if (d.flags.y) color = float3(mk_srgbToLinear(color.r), mk_srgbToLinear(color.g), mk_srgbToLinear(color.b));
  return float4(color, alpha);
}
