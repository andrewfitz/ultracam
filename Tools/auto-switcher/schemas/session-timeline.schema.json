{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ultracam-auto-switcher/session-timeline",
  "title": "Ultracam auto-switcher replay timeline",
  "description": "Complete media-clocked session ledger for reproducing realtime or offline cuts.",
  "type": "object",
  "required": [
    "schema_version", "session_id", "mode", "timebase", "duration", "config",
    "sources", "recordings", "events", "events_processed", "cuts", "instructions", "statuses"
  ],
  "properties": {
    "schema_version": { "enum": [2, 3] },
    "session_id": { "type": "string", "format": "uuid" },
    "mode": { "enum": ["realtime", "offline"] },
    "timebase": {
      "type": "object",
      "required": ["kind", "units", "timescale", "epoch", "origin"],
      "properties": {
        "kind": { "const": "media" },
        "units": { "const": "seconds" },
        "timescale": { "type": "integer", "minimum": 1 },
        "epoch": { "type": "integer" },
        "origin": { "type": "string" }
      },
      "additionalProperties": false
    },
    "started_at_unix_ms": { "type": ["integer", "null"] },
    "ended_at_unix_ms": { "type": ["integer", "null"] },
    "duration": { "type": "number", "minimum": 0 },
    "config": { "type": "object" },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    },
    "recordings": {
      "type": "array",
      "items": { "$ref": "#/$defs/recording" }
    },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/event" }
    },
    "events_processed": { "type": "integer", "minimum": 0 },
    "cuts": {
      "type": "array",
      "items": { "$ref": "#/$defs/cut" }
    },
    "instructions": { "type": "array", "items": { "type": "object" } },
    "statuses": { "type": "array", "items": { "type": "object" } },
    "metadata": { "type": "object", "additionalProperties": { "type": "string" } }
  },
  "$defs": {
    "timebase": {
      "type": "object",
      "required": ["kind", "units", "timescale", "epoch", "origin"],
      "properties": {
        "kind": { "type": "string" },
        "units": { "type": "string" },
        "timescale": { "type": "integer", "minimum": 1 },
        "epoch": { "type": "integer" },
        "origin": { "type": "string" }
      }
    },
    "source": {
      "type": "object",
      "required": ["camera_id", "role", "timebase"],
      "properties": {
        "camera_id": { "type": "string", "minLength": 1 },
        "role": { "type": "string" },
        "label": { "type": ["string", "null"] },
        "media_file": { "type": ["string", "null"] },
        "media_start": { "type": ["number", "null"] },
        "media_end": { "type": ["number", "null"] },
        "timebase": { "$ref": "#/$defs/timebase" }
      }
    },
    "recording": {
      "type": "object",
      "required": ["recording_id", "camera_id", "path", "kind"],
      "properties": {
        "recording_id": { "type": "string", "format": "uuid" },
        "camera_id": { "type": "string" },
        "path": { "type": "string" },
        "kind": { "enum": ["source", "program", "audio", "unknown"] },
        "format": { "type": ["string", "null"] },
        "media_start": { "type": ["number", "null"] },
        "media_end": { "type": ["number", "null"] }
      }
    },
    "event": {
      "type": "object",
      "required": ["sequence", "event", "outputs"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "media_time": { "type": ["number", "null"] },
        "media_time_ticks": { "type": ["integer", "null"] },
        "event": { "type": "object" },
        "outputs": { "type": "array", "items": { "type": "object" } }
      }
    },
    "cut": {
      "type": "object",
      "required": ["session_generation", "target_camera_id", "reason", "forced", "status"],
      "properties": {
        "decision_id": { "type": ["string", "null"], "format": "uuid" },
        "session_generation": { "type": "integer", "minimum": 1 },
        "from_camera_id": { "type": ["string", "null"] },
        "target_camera_id": { "type": "string", "minLength": 1 },
        "requested_cut_time": { "type": ["number", "null"] },
        "requested_cut_time_ticks": { "type": ["integer", "null"] },
        "applied_source_time": { "type": ["number", "null"] },
        "applied_source_time_ticks": { "type": ["integer", "null"] },
        "applied_program_time": { "type": ["number", "null"] },
        "applied_program_time_ticks": { "type": ["integer", "null"] },
        "expires_at": { "type": ["number", "null"] },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "reason": { "type": "string" },
        "forced": { "type": "boolean" },
        "status": { "enum": ["proposed", "applied", "expired", "cancelled", "rejected"] }
      }
    }
  }
}
