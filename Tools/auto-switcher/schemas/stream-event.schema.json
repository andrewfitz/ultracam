{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ultracam-auto-switcher/stream-event",
  "title": "Auto switcher stream event",
  "type": "object",
  "required": ["type"],
  "properties": {
    "type": { "enum": ["audio", "transcript", "video", "tick", "acknowledge", "reject", "manualOverride", "reset", "directorOutput"] },
    "cue": { "type": "object" },
    "observation": { "type": "object" },
    "time": { "type": "number", "minimum": 0 },
    "decision_id": { "type": "string", "format": "uuid" },
    "applied_at": { "type": ["number", "null"], "minimum": 0 },
    "camera_id": { "type": "string" },
    "generation": { "type": ["integer", "null"], "minimum": 1 }
  },
  "additionalProperties": true
}
